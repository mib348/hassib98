  }

  body[data-order-ui-page="datum"] .datum-action-stack #badge-counter[style*="inline"],
  body[data-order-ui-page="datum"] .datum-action-stack #badge-counter-yesterday[style*="inline"],
  body[data-order-ui-page="datum"] .datum-action-stack #badge-counter.yesterday-inline-flex,
  body[data-order-ui-page="datum"] .datum-action-stack #badge-counter-yesterday.yesterday-inline-flex {
    display: inline-flex !important;
  }

  body[data-order-ui-page="datum"] .datum-action-stack #badge-counter.text-bg-success,
  body[data-order-ui-page="datum"] .datum-action-stack #badge-counter-yesterday.text-bg-success {
    background-color: #167a45 !important;
    color: #ffffff !important;
  }

  body[data-order-ui-page="datum"] .datum-action-stack #badge-counter.text-bg-danger,
  body[data-order-ui-page="datum"] .datum-action-stack #badge-counter-yesterday.text-bg-danger {
