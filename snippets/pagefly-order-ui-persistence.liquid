{% doc %}
  Keeps the Bootstrap card layout on the PageFly datum and bestellen pages.

  PageFly owns the generated section files and can replace their HTML whenever
  a merchant republishes a page. This theme-owned snippet runs after PageFly,
  recognizes the stable business-control IDs and classes, and restores only the
  presentation wrapper. Existing click handlers, URLs, Liquid values, and
  availability logic stay attached to the original controls.
{% enddoc %}

<div
  id="pagefly-order-ui-persistence"
  data-page="{% if request.path == '/pages/datum' %}datum{% else %}bestellen{% endif %}"
  hidden
></div>

<style>
  body[data-order-ui-page] .datum-bootstrap-shell,
  body[data-order-ui-page] .bestellen-bootstrap-shell {
    box-sizing: border-box;
    margin-left: auto;
    margin-right: auto;
    padding-left: 12px;
    padding-right: 12px;
    width: 100%;
  }

  body[data-order-ui-page] .datum-bootstrap-card,
  body[data-order-ui-page] .bestellen-bootstrap-card {
    --order-ui-accent: #ff045e;
    --order-ui-copy: #ffffff;
    --order-ui-muted-copy: rgba(255, 255, 255, 0.78);
    --order-ui-panel: rgba(8, 8, 8, 0.88);
    --order-ui-soft-surface: rgba(255, 255, 255, 0.08);
    background: var(--order-ui-panel) !important;
    border: 1px solid rgba(255, 4, 94, 0.5) !important;
    border-radius: 8px !important;
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.42) !important;
    color: var(--order-ui-copy) !important;
    margin-left: auto;
    margin-right: auto;
    max-width: 420px;
    overflow: visible !important;
    width: 100%;
  }

  body[data-order-ui-page] .datum-bootstrap-card .card-body,
  body[data-order-ui-page] .bestellen-bootstrap-card .card-body {
    padding: 2.25rem !important;
    position: relative;
  }

  body[data-order-ui-page] .datum-bootstrap-card .card-body::before,
  body[data-order-ui-page] .bestellen-bootstrap-card .card-body::before {
    background: var(--order-ui-accent);
    border-radius: 999px;
    content: "";
    display: block;
    height: 3px;
    margin: 0 auto 1.25rem;
    width: 72px;
  }

  body[data-order-ui-page] .datum-bootstrap-card .card-title,
  body[data-order-ui-page] .bestellen-bootstrap-card .card-title {
    background: transparent !important;
    color: var(--order-ui-copy) !important;
    display: block !important;
    font-family: "Bebas Neue", sans-serif !important;
    font-size: 52px !important;
    font-weight: 500 !important;
    line-height: 1.1 !important;
    padding: 0 !important;
    text-transform: lowercase;
  }

  body[data-order-ui-page="datum"] .datum-bootstrap-card .card-title {
    margin: 0 0 0.5rem !important;
  }

  body[data-order-ui-page="bestellen"] .bestellen-bootstrap-card .card-title {
    margin: 0 0 1.4rem !important;
  }

  body[data-order-ui-page="datum"] .datum-bootstrap-card #note,
  body[data-order-ui-page="datum"] .datum-bootstrap-card .status-delivery-today {
    background: transparent !important;
    color: var(--order-ui-muted-copy) !important;
    display: block !important;
    font-family: Faustina, serif !important;
    margin: 0 !important;
