  body[data-order-ui-page="datum"] .datum-action-stack .preorderbtn.show-button,
  body[data-order-ui-page="datum"] .datum-action-stack .todayorderbtn.show-button,
  body[data-order-ui-page="datum"] .datum-action-stack .yesterdayorderbtn.show-button,
  body[data-order-ui-page="datum"] .datum-action-stack .snacks_and_drinks_btn.show-button,
  body[data-order-ui-page="datum"] .datum-action-stack .snacks_and_drinks_btn[style*="inline-flex"] {
