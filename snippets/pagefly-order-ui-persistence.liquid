  }

  body[data-order-ui-page="datum"] .datum-action-stack .preorderbtn:hover,
  body[data-order-ui-page="datum"] .datum-action-stack .todayorderbtn:hover,
  body[data-order-ui-page="datum"] .datum-action-stack .yesterdayorderbtn:hover,
  body[data-order-ui-page="datum"] .datum-action-stack .snacks_and_drinks_btn:hover,
  body[data-order-ui-page="bestellen"] #stationDropdown:hover,
  body[data-order-ui-page="bestellen"] #stationDropdown:focus-visible,
  body[data-order-ui-page="bestellen"] #home_delivery_btn:hover,
  body[data-order-ui-page="bestellen"] #home_delivery_btn:focus-visible {
