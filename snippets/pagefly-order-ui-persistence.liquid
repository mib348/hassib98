  }

  body[data-order-ui-page="datum"] .datum-action-stack .loading_icon {
    display: block;
    height: 18px;
    width: 18px;
  }

  body[data-order-ui-page="datum"] .datum-bootstrap-card #datepicker {
    margin-left: auto;
    margin-right: auto;
  }

  body[data-order-ui-page="bestellen"] #stationDropdown,
  body[data-order-ui-page="bestellen"] #next_button,
  body[data-order-ui-page="bestellen"] #home_delivery_btn {
    display: inline-flex;
    font-size: 21px !important;
    min-height: 56px !important;
    padding: 0.85rem 1.1rem !important;
  }

  body[data-order-ui-page="bestellen"] #stationDropdown[style*="background-color:black"],
  body[data-order-ui-page="bestellen"] #stationDropdown[style*="background-color: black"] {
    background-color: rgba(0, 0, 0, 0.74) !important;
    border-color: var(--order-ui-accent) !important;
  }

  body[data-order-ui-page="bestellen"] #next_button {
    background-color: #198754 !important;
    border-color: #198754 !important;
    color: #ffffff !important;
    display: none;
  }

  body[data-order-ui-page="bestellen"] #next_button:hover,
  body[data-order-ui-page="bestellen"] #next_button:focus-visible {
    background-color: #157347 !important;
    border-color: #146c43 !important;
    color: #ffffff !important;
    transform: translateY(-1px);
  }

  body[data-order-ui-page="bestellen"] #next_button[style*="inline"],
  body[data-order-ui-page="bestellen"] #next_button[style*="block"] {
    display: inline-flex !important;
  }

  body[data-order-ui-page="bestellen"] #home_delivery_btn {
    display: none !important;
  }

  body[data-order-ui-page="bestellen"] .bestellen-station-dropdown .dropdown-menu {
    background: rgba(10, 10, 10, 0.96) !important;
    border: 1px solid rgba(255, 4, 94, 0.48) !important;
    border-radius: 8px !important;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.42) !important;
    left: 0 !important;
    margin-top: 0.55rem !important;
    max-height: min(24rem, calc(100vh - 14rem));
    max-width: calc(100vw - 2rem);
    min-width: 100% !important;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 0.45rem !important;
    right: auto !important;
    top: 100% !important;
    width: 100%;
    z-index: 1100 !important;
  }

  body[data-order-ui-page="bestellen"] .bestellen-station-dropdown .dropdown-header {
    color: var(--order-ui-accent) !important;
    font-family: "Bebas Neue", sans-serif !important;
    font-size: 17px !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    padding: 0.7rem 0.85rem 0.35rem !important;
  }

  body[data-order-ui-page="bestellen"] .bestellen-station-dropdown .station {
    background: transparent !important;
    border-radius: 6px !important;
    color: var(--order-ui-copy) !important;
    font-family: "Bebas Neue", sans-serif !important;
    font-size: 20px !important;
    font-weight: 400 !important;
    line-height: 1.15 !important;
    overflow-wrap: anywhere;
    padding: 0.72rem 0.85rem !important;
    white-space: normal !important;
  }

  body[data-order-ui-page="bestellen"] .bestellen-station-dropdown .station:hover,
  body[data-order-ui-page="bestellen"] .bestellen-station-dropdown .station:focus {
    background: var(--order-ui-accent) !important;
    color: #ffffff !important;
  }

  body[data-order-ui-page] .bestellen-disabled,
  body[data-order-ui-page] button:disabled,
  body[data-order-ui-page] [aria-disabled="true"] {
    cursor: not-allowed !important;
    filter: grayscale(0.35);
    opacity: 0.55 !important;
    pointer-events: none;
    transform: none !important;
  }

  @media (max-width: 576px) {
    body[data-order-ui-page] .datum-bootstrap-card .card-body,
    body[data-order-ui-page] .bestellen-bootstrap-card .card-body {
      padding: 1.35rem !important;
    }

    body[data-order-ui-page] .datum-bootstrap-card .card-title,
    body[data-order-ui-page] .bestellen-bootstrap-card .card-title {
      font-size: 38px !important;
    }

    body[data-order-ui-page="datum"] .datum-bootstrap-card #note {
      font-size: 15px !important;
    }

    body[data-order-ui-page="datum"] .datum-action-stack .preorderbtn,
    body[data-order-ui-page="datum"] .datum-action-stack .todayorderbtn,
    body[data-order-ui-page="datum"] .datum-action-stack .yesterdayorderbtn,
    body[data-order-ui-page="datum"] .datum-action-stack .snacks_and_drinks_btn {
      font-size: 18px !important;
      min-height: 52px !important;
      padding: 0.7rem 0.9rem !important;
    }

    body[data-order-ui-page="datum"] .datum-action-stack .mobile-order-buttons-wrapper {
      display: contents !important;
    }

    body[data-order-ui-page="bestellen"] #stationDropdown,
    body[data-order-ui-page="bestellen"] #next_button,
    body[data-order-ui-page="bestellen"] #home_delivery_btn {
      font-size: 19px !important;
      min-height: 54px !important;
      padding: 0.78rem 0.95rem !important;
    }

    body[data-order-ui-page="bestellen"] .bestellen-station-dropdown .dropdown-menu {
      max-height: min(22rem, calc(100vh - 12rem));
    }
  }
</style>

<script>
  (() => {
    'use strict';

    const marker = document.getElementById('pagefly-order-ui-persistence');
    if (!marker || window.__pageflyOrderUiPersistenceLoaded) return;

    window.__pageflyOrderUiPersistenceLoaded = true;
    const page = marker.dataset.page;
    document.body.dataset.orderUiPage = page;

    const addClasses = (element, classNames) => {
      if (!element) return;
      element.classList.add(...classNames.split(' '));
    };

    const makeDiv = (className) => {
      const element = document.createElement('div');
      element.className = className;
      return element;
    };

    const pageflyRoot = (sectionId, legacyClass) => {
      return document.querySelector(`.${legacyClass}`)
        || document.querySelector(`[data-section-id="${sectionId}"]`)?.closest('.__pf');
    };

    const commonAncestor = (elements, fallback) => {
      const validElements = elements.filter(Boolean);
      let ancestor = validElements[0]?.parentElement;

      while (ancestor && !validElements.every((element) => ancestor.contains(element))) {
        ancestor = ancestor.parentElement;
      }

      return ancestor || fallback;
    };

    const topLevelChild = (container, element) => {
      let child = element;
      while (child?.parentElement && child.parentElement !== container) {
        child = child.parentElement;
      }
      return child;
    };

    const hideVacatedRows = (rows, card) => {
      rows.forEach((row) => {
        if (row && !row.contains(card) && !card.contains(row)) {
          row.hidden = true;
        }
      });
    };

    const createCard = (type, host, anchor) => {
      const shell = makeDiv(`${type}-bootstrap-shell container`);
      const row = makeDiv('row justify-content-center');
      const column = makeDiv(type === 'datum'
        ? 'col-12 col-md-10 col-lg-11 col-xl-10'
        : 'col-12 col-md-10 col-lg-9 col-xl-8');
      const card = makeDiv(`${type}-bootstrap-card card shadow`);
      const body = makeDiv('card-body text-center');

      card.appendChild(body);
      column.appendChild(card);
      row.appendChild(column);
      shell.appendChild(row);
      host.insertBefore(shell, anchor || host.firstChild);

      return { shell, card, body };
    };

    const ensureButtonLabel = (button) => {
      if (!button || button.querySelector(':scope > .datum-button-label')) return;

      const textNodes = Array.from(button.childNodes).filter((node) => {
        return node.nodeType === Node.TEXT_NODE && node.textContent.trim();
      });

      if (!textNodes.length) return;

      const label = document.createElement('span');
      label.className = 'datum-button-label';
      textNodes.forEach((node) => label.appendChild(node));
      button.insertBefore(label, button.firstChild);
    };

    const pairButtonAndBadge = (button, badge) => {
      if (!button || !badge || badge.parentElement === button) return;

      let wrapper = button.closest('.datum-persistent-button');
      if (!wrapper) {
        wrapper = makeDiv('datum-persistent-button');
        button.parentElement.insertBefore(wrapper, button);
        wrapper.appendChild(button);
      }

      let badgeSlot = wrapper.querySelector(':scope > .datum-persistent-badge-slot');
      if (!badgeSlot) {
        badgeSlot = makeDiv('datum-persistent-badge-slot');
        wrapper.appendChild(badgeSlot);
      }

      badgeSlot.appendChild(badge);
    };

    const normalizeDatum = () => {
      const root = pageflyRoot('pf-c722', '__pf_GlDVGOc7')
        || document.querySelector('.preorderbtn')?.closest('.__pf');
      if (!root) return;

      const heading = root.querySelector('h3');
      const note = root.querySelector('#note');
      const status = root.querySelector('.status-delivery-today');
      const statusRow = root.querySelector('.row-status-delivery-today') || status?.parentElement;
      const preorderButton = root.querySelector('.preorderbtn');
      const todayButton = root.querySelector('.todayorderbtn');
      const yesterdayButton = root.querySelector('.yesterdayorderbtn');
      const snacksButton = root.querySelector('.snacks_and_drinks_btn');
      const todayBadge = root.querySelector('#badge-counter');
      const yesterdayBadge = root.querySelector('#badge-counter-yesterday');
      const dateContent = root.querySelector('#datepicker')?.closest('[data-pf-type="Custom.HTML"]')
        || root.querySelector('[data-pf-type="Custom.HTML"]');

      if (!heading || !preorderButton || !todayButton || !yesterdayButton || !snacksButton) return;

      let card = root.querySelector('.datum-bootstrap-card');
      let body = card?.querySelector('.card-body');

      if (!card || !body) {
        const movable = [
          heading,
          note,
          statusRow,
          preorderButton,
          todayButton,
          todayBadge,
          yesterdayButton,
          yesterdayBadge,
          snacksButton,
          dateContent,
        ];
        const host = commonAncestor(movable, root);
        const anchor = topLevelChild(host, heading);
        const rowsToHide = movable.map((element) => element?.closest('[data-pf-type="Row"]'));
        ({ card, body } = createCard('datum', host, anchor));

        body.appendChild(heading);
        if (note) body.appendChild(note);
        if (statusRow) body.appendChild(statusRow);

        const actionStack = makeDiv('datum-action-stack d-flex flex-column align-items-stretch');
        actionStack.append(preorderButton, todayButton, yesterdayButton, snacksButton);
        body.appendChild(actionStack);
        if (dateContent) body.appendChild(dateContent);

        hideVacatedRows(rowsToHide, card);
      }

      const actionStack = body.querySelector('.datum-action-stack') || (() => {
        const stack = makeDiv('datum-action-stack d-flex flex-column align-items-stretch');
        body.insertBefore(stack, dateContent || null);
        stack.append(preorderButton, todayButton, yesterdayButton, snacksButton);
        return stack;
      })();

      addClasses(card, 'datum-bootstrap-card card shadow');
      addClasses(body, 'card-body text-center');
      addClasses(heading, 'card-title');
      addClasses(actionStack, 'datum-action-stack d-flex flex-column align-items-stretch');

      [preorderButton, todayButton, yesterdayButton, snacksButton].forEach((button) => {
        addClasses(button, 'btn btn-outline-light btn-lg');
        ensureButtonLabel(button);
      });

      pairButtonAndBadge(todayButton, todayBadge);
      pairButtonAndBadge(yesterdayButton, yesterdayBadge);
      addClasses(todayBadge, 'badge rounded-pill datum-count-badge');
      addClasses(yesterdayBadge, 'badge rounded-pill datum-count-badge');
      if (dateContent) addClasses(dateContent, 'mt-4');

      root.dataset.orderUiPersistent = 'datum';
    };

    const initializeDropdown = (button) => {
      if (button && window.bootstrap?.Dropdown) {
        window.bootstrap.Dropdown.getOrCreateInstance(button);
      }
    };

    const normalizeBestellen = () => {
      const root = pageflyRoot('pf-c4c4', '__pf_LM5usA9o')
        || document.querySelector('#stationDropdown')?.closest('.__pf');
      if (!root) return;

      const heading = root.querySelector('h3');
      const locationPortion = root.querySelector('.location_portion');
      const locationContent = locationPortion?.closest('[data-pf-type="Custom.HTML"]') || locationPortion;
      const stationButton = root.querySelector('#stationDropdown');
      const nextButton = root.querySelector('#next_button');
      const homeButton = root.querySelector('#home_delivery_btn');

      if (!heading || !locationPortion || !stationButton || !nextButton || !homeButton) return;

      let card = root.querySelector('.bestellen-bootstrap-card');
      let body = card?.querySelector('.card-body');

      if (!card || !body) {
        const movable = [heading, locationContent];
        const host = commonAncestor(movable, root);
        const anchor = topLevelChild(host, heading);
        const rowsToHide = movable.map((element) => element?.closest('[data-pf-type="Row"]'));
        ({ card, body } = createCard('bestellen', host, anchor));

        body.appendChild(heading);
        body.appendChild(locationContent);
        hideVacatedRows(rowsToHide, card);
      }

      const dropdown = stationButton.closest('.dropdown') || stationButton.parentElement;
      const dropdownMenu = root.querySelector('.dropdown-menu');

      addClasses(card, 'bestellen-bootstrap-card card shadow');
      addClasses(body, 'card-body text-center');
      addClasses(heading, 'card-title');
      addClasses(locationPortion, 'bestellen-control-row d-flex flex-column align-items-stretch');
      addClasses(dropdown, 'dropdown bestellen-station-dropdown');
      addClasses(stationButton, 'btn btn-outline-light btn-lg dropdown-toggle');
      addClasses(nextButton, 'btn btn-success btn-lg');
      addClasses(homeButton, 'btn btn-outline-light btn-lg');

      stationButton.setAttribute('data-bs-toggle', 'dropdown');
      stationButton.setAttribute('data-bs-display', 'static');
      stationButton.removeAttribute('data-toggle');
      stationButton.removeAttribute('data-display');
      if (dropdownMenu) dropdownMenu.setAttribute('aria-labelledby', 'stationDropdown');

      initializeDropdown(stationButton);
      root.dataset.orderUiPersistent = 'bestellen';
    };

    const normalize = () => {
      if (page === 'datum') {
        normalizeDatum();
      } else {
        normalizeBestellen();
      }
    };

    const ensureBootstrap = () => {
      const version = '5.3.8';
      if (!document.querySelector(`link[href*="bootstrap@${version}"]`)) {
        const stylesheet = document.createElement('link');
        stylesheet.rel = 'stylesheet';
        stylesheet.href = `https://cdn.jsdelivr.net/npm/bootstrap@${version}/dist/css/bootstrap.min.css`;
        stylesheet.crossOrigin = 'anonymous';
        document.head.appendChild(stylesheet);
      }

      if (window.bootstrap?.Dropdown) return;
      if (document.querySelector(`script[data-order-ui-bootstrap="${version}"]`)) return;

      const script = document.createElement('script');
      script.src = `https://cdn.jsdelivr.net/npm/bootstrap@${version}/dist/js/bootstrap.bundle.min.js`;
      script.crossOrigin = 'anonymous';
      script.dataset.orderUiBootstrap = version;
      script.addEventListener('load', normalize, { once: true });
      document.head.appendChild(script);
    };

    let normalizationScheduled = false;
    const scheduleNormalization = () => {
      if (normalizationScheduled) return;
      normalizationScheduled = true;
      window.requestAnimationFrame(() => {
        normalizationScheduled = false;
        normalize();
      });
    };

    ensureBootstrap();
    normalize();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', normalize, { once: true });
    }

    document.addEventListener('shopify:section:load', scheduleNormalization);
    window.addEventListener('pageshow', scheduleNormalization);

    const observer = new MutationObserver(scheduleNormalization);
    observer.observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>
