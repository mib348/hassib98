    // =========================================================================
    // UPDATE TODAY BADGE COUNTER
    // =========================================================================
    // Shows ONLY today's inventory count on the "Sofortbestellung" (Today) button.
    // The API getImmediateInventoryByLocation now returns ONLY today's inventory
    // (not combined). Yesterday's inventory is shown separately on its own button.
    // strYStockOnlyCheck is always "N" for today button since yesterday has its own.
    // =========================================================================
    function updateTodayBadgeCounter(location) {
      console.log('[Delivery Date] updateTodayBadgeCounter called for location:', location);

      // Always set to "N" for today button - yesterday has its own button now
      window.deliveryDateState.strYStockOnlyCheck = "N";

      // Helper to update the badge display with a quantity
      function updateBadgeDisplay(qty) {
        console.log('[Delivery Date] Today badge display updated with qty:', qty);
        if (qty > 0) {
          $('#badge-counter')
            .html(qty)
            .removeClass('text-bg-danger')
            .addClass('text-bg-success')
            .css('display', 'inline-block');
        } else {
          $('#badge-counter')
            .html(0)
            .removeClass('text-bg-success')
            .addClass('text-bg-danger')
            .css('display', 'inline-block');
        }
      }

      // =========================================================================
      // FETCH TODAY'S INVENTORY ONLY
      // The API now returns ONLY today's inventory (not combined with yesterday).
      // No calculation needed - just display the returned value directly.
      // =========================================================================
      const todayUrl = `https://dev.sushi.catering/getImmediateInventoryByLocation/${location}`;
      console.log('[Delivery Date] Fetching today-only inventory from:', todayUrl);

      $.ajax({
        url: todayUrl,
        type: "GET",
        async: true,
        cache: false,  // Don't cache to ensure fresh data
        dataType: "json",
        success: function(todayQty) {
          console.log('[Delivery Date] Today inventory received:', todayQty);
          updateBadgeDisplay(todayQty);
        },
        error: function(request, status, error) {
          console.error('[Delivery Date] Error fetching today inventory:', error);
          updateBadgeDisplay(0);
        }
      });
    }
  
    // Process location and setup all functionality
    function processLocationAndSetup() {
      const strLocation = window.deliveryDateState.location || "";

      console.log('[Delivery Date] processLocationAndSetup called with location:', strLocation);

      if (strLocation === "") {
        console.log('[Delivery Date] No location available, skipping initialization');
        removeLoadingStates();
        return;
      }

      $("#badge-counter").html('<img src="https://raw.githubusercontent.com/Codelessly/FlutterLoadingGIFs/master/packages/cupertino_activity_indicator_square_large.gif" height="21px" width="21px" class="loading_icon" />');

      const ajaxUrl = `https://dev.sushi.catering/getLocations/${strLocation}`;
      console.log('[Delivery Date] Fetching location data from:', ajaxUrl);

      // Make AJAX call asynchronous to prevent UI blocking
      $.ajax({
        url: ajaxUrl,
        type: "GET",
        async: true, // Changed from false to true
        cache: true,
        dataType: "json",
        success: function(data) {
          console.log('[Delivery Date] Location data received:', data);
          window.deliveryDateState.locationData = data;
          setupLocationData(data);
          setupButtonHandlers();
          removeLoadingStates();
          
          // Re-sync badge counter height after buttons are shown
          syncBadgeCounterHeight();
        },
        error: function(request, status, error) {
          console.error('[Delivery Date] Error fetching location data:', {
            status,
            error,
            url: ajaxUrl
          });
          removeLoadingStates();
        }
      });
    }
  
    // Setup location-specific data
    function setupLocationData(data) {
      console.log('[Delivery Date] setupLocationData called with data:', data);

      // Save the same-day preorder end time
      window.samedayPreorderEndTime = data.sameday_preorder_end_time;
      window.firstAdditionalInventoryPreorderEndTime = data.first_additional_inventory_end_time;
      window.additionalInventoryPreorderEndTime = data.second_additional_inventory_end_time;
      window.immediate_inventory_quantity_check_time = data.immediate_inventory_quantity_check_time;
      window.b_additional_inventory = data.additional_inventory;
      window.accept_only_preorders = data.accept_only_preorders;
      window.immediate_inventory = data.immediate_inventory;

      console.log('[Delivery Date] Window variables set:', {
        samedayPreorderEndTime: window.samedayPreorderEndTime,
        firstAdditionalInventoryPreorderEndTime: window.firstAdditionalInventoryPreorderEndTime,
        additionalInventoryPreorderEndTime: window.additionalInventoryPreorderEndTime,
        immediate_inventory_quantity_check_time: window.immediate_inventory_quantity_check_time,
        b_additional_inventory: window.b_additional_inventory,
        accept_only_preorders: window.accept_only_preorders,
        immediate_inventory: window.immediate_inventory
      });

      sessionStorage.setItem("no_station", data.no_station);
      sessionStorage.setItem("b_additional_inventory", data.additional_inventory);
      sessionStorage.setItem("immediate_inventory", data.immediate_inventory);

      console.log('[Delivery Date] SessionStorage updated:', {
        no_station: data.no_station,
        b_additional_inventory: data.additional_inventory,
        immediate_inventory: data.immediate_inventory
