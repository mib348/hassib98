          toggleButton(data.start_time, data.end_time);
          setInterval(() => {toggleButton(data.start_time, data.end_time);}, 60000);

          // =========================================================================
          // CONSOLIDATED INVENTORY FETCH
          // Fetch yesterday's inventory ONCE and use it for:
          // 1. Today badge: combined - yesterday = today's inventory only
          // 2. Yesterday button: show if yesterdayQty > 0 (when 48h feature enabled)
          // This eliminates the duplicate AJAX call that was happening before.
