            console.log('[Delivery Date] Fetching yesterday inventory from:', yesterdayUrl);

            $.ajax({
              url: yesterdayUrl,
              type: "GET",
              async: true,
              cache: true,
              dataType: "json",
              success: function(yesterdayQty) {
                console.log('[Delivery Date] Yesterday inventory received:', yesterdayQty);

                // Update TODAY badge (API now returns only today's inventory)
                updateTodayBadgeCounter(window.deliveryDateState.location);

                // =========================================================================
                // YESTERDAY BUTTON: ALWAYS SHOW when 48h feature is enabled
                // - If qty > 0: show button enabled with green badge
                // - If qty === 0: show button disabled with red zero badge
                // This ensures users always see the yesterday option is available
                // even when temporarily out of stock
                // =========================================================================
                setYesterdayDisplay(true);
                const buttonYesterdayOrder = document.querySelector('.yesterdayorderbtn');

                if (yesterdayQty > 0) {
                  // Items available: enable button with green badge
                  if (buttonYesterdayOrder) {
                    setActionButtonDisabled(buttonYesterdayOrder, false);
                  }
                  $('#badge-counter-yesterday')
                    .html(yesterdayQty)
