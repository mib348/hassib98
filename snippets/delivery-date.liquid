  <script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker@1.10.0/dist/locales/bootstrap-datepicker.de.min.js" defer="defer"></script>

  <div id="datepicker-shell" class="datum-datepicker-shell is-hidden" aria-hidden="true">
    <div id="datepicker" data-date="" aria-label="Vorbestelldatum auswählen"></div>
  </div>
  
  <script>
    // Global state management
    window.deliveryDateState = {
      isInitialized: false,
      location: null,
      locationData: null,
      jqueryReady: false,
      datepickerReady: false,
      domReady: false,
      strYStockOnlyCheck: "N"
    };

    function waitForBootstrapDatepicker() {
      if (!window.jQuery) return;

      window.deliveryDateState.jqueryReady = true;

      const markDatepickerReady = function() {
        if (window.jQuery.fn && window.jQuery.fn.datepicker) {
          window.deliveryDateState.datepickerReady = true;
          console.log('[Delivery Date] Bootstrap datepicker is ready');
          initializeDeliveryDate();
          return true;
        }
        return false;
      };

      if (markDatepickerReady()) return;

      const checkDatepicker = setInterval(function() {
        if (markDatepickerReady()) {
          clearInterval(checkDatepicker);
        }
      }, 100);

      setTimeout(function() {
        if (!window.deliveryDateState.datepickerReady) {
          clearInterval(checkDatepicker);
          console.error('[Delivery Date] Bootstrap datepicker failed to load within 10 seconds');
          removeLoadingStates();
        }
      }, 10000);
    }
  
    // Initialize everything when ready
    function initializeDeliveryDate() {
      console.log('[Delivery Date] initializeDeliveryDate called', {
        isInitialized: window.deliveryDateState.isInitialized,
        domReady: window.deliveryDateState.domReady,
        jqueryReady: window.deliveryDateState.jqueryReady,
        datepickerReady: window.deliveryDateState.datepickerReady
      });

      if (window.deliveryDateState.isInitialized) {
        console.log('[Delivery Date] Already initialized, skipping');
        return;
      }

      // Check if all dependencies are ready
      if (!window.deliveryDateState.domReady || !window.deliveryDateState.jqueryReady || !window.deliveryDateState.datepickerReady) {
        console.log('[Delivery Date] Dependencies not ready yet', {
          domReady: window.deliveryDateState.domReady,
          jqueryReady: window.deliveryDateState.jqueryReady,
          datepickerReady: window.deliveryDateState.datepickerReady
        });
        return;
      }

      console.log('[Delivery Date] All dependencies ready, initializing functionality...');

      const buttonTodayOrder = document.querySelector('.todayorderbtn');
      const buttonPreOrder = document.querySelector('.preorderbtn');
      const buttonSnacksAndDrinks = document.querySelector('.snacks_and_drinks_btn');
      const buttonYesterdayOrder = document.querySelector('.yesterdayorderbtn');

      console.log('[Delivery Date] Buttons found:', {
        todayOrderBtn: !!buttonTodayOrder,
        preOrderBtn: !!buttonPreOrder,
        snacksAndDrinksBtn: !!buttonSnacksAndDrinks,
        yesterdayOrderBtn: !!buttonYesterdayOrder
      });

      // Add loading state to buttons initially
      if (buttonTodayOrder) buttonTodayOrder.classList.add('btn-loading');
      if (buttonPreOrder) buttonPreOrder.classList.add('btn-loading');
      if (buttonSnacksAndDrinks) buttonSnacksAndDrinks.classList.add('btn-loading');
      if (buttonYesterdayOrder) buttonYesterdayOrder.classList.add('btn-loading');

      // Sync badge counter height with buttons on small devices
      syncBadgeCounterHeight();
      wrapImmediateButtonsForMobile();

      // Process location and setup functionality
      processLocationAndSetup();

      window.deliveryDateState.isInitialized = true;
      console.log('[Delivery Date] Initialization complete');
    }

    // Sync badge counter height with buttons on small devices
    function syncBadgeCounterHeight() {
      const badgeCounter = document.getElementById('badge-counter');
      if (!badgeCounter) return;
      
      // Only apply on small devices (576px and below)
      if (window.innerWidth <= 576) {
        const button = document.querySelector('.preorderbtn, .todayorderbtn, .snacks_and_drinks_btn');
        if (button) {
          const computedStyle = window.getComputedStyle(button);
          const buttonPadding = computedStyle.padding;
          const buttonMinHeight = computedStyle.minHeight;
          
          // Apply same padding and min-height to badge counter
          // Note: Do not set display property here as it interferes with toggleButton() visibility control
          badgeCounter.style.padding = buttonPadding;
          badgeCounter.style.minHeight = buttonMinHeight;
          badgeCounter.style.boxSizing = 'border-box';
          badgeCounter.style.alignItems = 'center';
          badgeCounter.style.justifyContent = 'center';
        }
      }
    }

    // Group immediate order buttons with their badges on mobile so the parent can be flexed
    function wrapImmediateButtonsForMobile() {
      const isMobile = window.innerWidth <= 576;

      const pairs = [
        {
          button: document.querySelector('.todayorderbtn'),
          badge: document.getElementById('badge-counter'),
          wrapperClass: 'mobile-sofortkauf-heute-wrapper'
        },
        {
          button: document.querySelector('.yesterdayorderbtn'),
          badge: document.getElementById('badge-counter-yesterday'),
          wrapperClass: 'mobile-sofortkauf-gestern-wrapper'
        }
      ];

      pairs.forEach(({ button, badge, wrapperClass }) => {
        if (!button || !badge) return;

        const haveSameParent = button.parentNode && button.parentNode === badge.parentNode;
        if (!haveSameParent) return;

        const existingWrapper = button.closest(`.${wrapperClass}`) || badge.closest(`.${wrapperClass}`);

        if (isMobile) {
          if (existingWrapper) return;

          const wrapper = document.createElement('div');
          wrapper.className = `mobile-sofortkauf-pair ${wrapperClass}`;

          const firstNode = (button.compareDocumentPosition(badge) & Node.DOCUMENT_POSITION_PRECEDING) ? badge : button;
          button.parentNode.insertBefore(wrapper, firstNode);

          if (firstNode === badge) {
            wrapper.appendChild(badge);
            wrapper.appendChild(button);
          } else {
            wrapper.appendChild(button);
            wrapper.appendChild(badge);
          }
        } else if (existingWrapper) {
          const parent = existingWrapper.parentNode;
          while (existingWrapper.firstChild) {
            parent.insertBefore(existingWrapper.firstChild, existingWrapper);
          }
          parent.removeChild(existingWrapper);
        }
      });

      const pairNodes = document.querySelectorAll('.mobile-sofortkauf-pair');

      if (isMobile && pairNodes.length) {
        let container = document.querySelector('.mobile-sofortkauf-container');

        if (!container) {
          container = document.createElement('div');
          container.className = 'mobile-sofortkauf-container';
          const firstPair = pairNodes[0];
          firstPair.parentNode.insertBefore(container, firstPair);
        }

        pairNodes.forEach((pair) => {
          if (pair.parentNode !== container) {
            container.appendChild(pair);
          }
        });
      } else {
        const container = document.querySelector('.mobile-sofortkauf-container');
        if (container) {
          const parent = container.parentNode;
          while (container.firstChild) {
            parent.insertBefore(container.firstChild, container);
          }
          parent.removeChild(container);
        }
      }

      const orderCandidates = Array.from(document.querySelectorAll('.mobile-sofortkauf-container, .preorderbtn, .snacks_and_drinks_btn'));

      if (isMobile && orderCandidates.length) {
        let orderWrapper = document.querySelector('.mobile-order-buttons-wrapper');
        if (!orderWrapper) {
          orderWrapper = document.createElement('div');
          orderWrapper.className = 'mobile-order-buttons-wrapper';
          const firstNode = orderCandidates[0];
          firstNode.parentNode.insertBefore(orderWrapper, firstNode);
        }

        const sortedNodes = [...orderCandidates].sort((a, b) => {
          const position = a.compareDocumentPosition(b);
          if (position & Node.DOCUMENT_POSITION_PRECEDING) return 1;
          if (position & Node.DOCUMENT_POSITION_FOLLOWING) return -1;
          return 0;
        });

        sortedNodes.forEach((node) => {
          if (node.parentNode !== orderWrapper) {
            orderWrapper.appendChild(node);
          }
        });
      } else {
        const orderWrapper = document.querySelector('.mobile-order-buttons-wrapper');
        if (orderWrapper) {
          const parent = orderWrapper.parentNode;
          while (orderWrapper.firstChild) {
            parent.insertBefore(orderWrapper.firstChild, orderWrapper);
          }
          parent.removeChild(orderWrapper);
        }
      }
    }

    // Show/hide yesterday button & badge with inline-flex !important when enabled
    function setYesterdayDisplay(isEnabled) {
      const buttonYesterdayOrder = document.querySelector('.yesterdayorderbtn');
      const badgeYesterday = document.getElementById('badge-counter-yesterday');

      if (isEnabled) {
        if (buttonYesterdayOrder) {
          buttonYesterdayOrder.classList.add('show-button', 'yesterday-inline-flex');
          buttonYesterdayOrder.classList.remove('yesterday-hidden');
        }
        if (badgeYesterday) {
          badgeYesterday.classList.add('yesterday-inline-flex');
          badgeYesterday.classList.remove('yesterday-hidden');
        }
      } else {
        if (buttonYesterdayOrder) {
          buttonYesterdayOrder.classList.remove('show-button', 'yesterday-inline-flex');
          buttonYesterdayOrder.classList.add('yesterday-hidden');
        }
        if (badgeYesterday) {
          badgeYesterday.classList.remove('yesterday-inline-flex');
          badgeYesterday.classList.add('yesterday-hidden');
        }
      }
    }

    function setActionButtonDisabled(button, isDisabled, reason) {
      if (!button) return;

      button.classList.toggle('disabled', isDisabled);
      button.setAttribute('aria-disabled', isDisabled ? 'true' : 'false');

      if (isDisabled) {
        button.setAttribute('tabindex', '-1');
        button.setAttribute('title', reason || 'Nicht verfügbar');
        button.dataset.disabledReason = reason || 'Nicht verfügbar';
      } else {
        button.removeAttribute('tabindex');
        button.removeAttribute('title');
        delete button.dataset.disabledReason;
      }
    }

    function isActionButtonDisabled(button) {
      return !!button && (
        button.classList.contains('disabled') ||
        button.getAttribute('aria-disabled') === 'true'
      );
    }

    let preorderDatepickerAnchor = null;

    function movePreorderDatepickerShellToBody() {
      const shell = document.getElementById('datepicker-shell');

      if (shell && shell.parentNode !== document.body) {
        document.body.appendChild(shell);
      }
    }

    function positionPreorderDatepicker(anchorButton) {
      const shell = document.getElementById('datepicker-shell');

      if (!shell || !anchorButton || shell.classList.contains('is-hidden')) return;

      const buttonRect = anchorButton.getBoundingClientRect();
      const viewportPadding = 12;
      const verticalGap = 8;
      const maxOverlayWidth = window.innerWidth - (viewportPadding * 2);
      const shellWidth = Math.min(shell.offsetWidth || 286, maxOverlayWidth);

      /*
        The calendar should feel attached to the preorder button, not the whole
        card. Center it under the button first, then clamp it inside the viewport
        so small screens never create horizontal scrolling.
      */
      const centeredLeft = window.scrollX + buttonRect.left + ((buttonRect.width - shellWidth) / 2);
      const minLeft = window.scrollX + viewportPadding;
      const maxLeft = window.scrollX + window.innerWidth - shellWidth - viewportPadding;
      const clampedLeft = Math.min(Math.max(centeredLeft, minLeft), maxLeft);
      const top = window.scrollY + buttonRect.bottom + verticalGap;

      shell.style.left = Math.round(clampedLeft) + 'px';
      shell.style.top = Math.round(top) + 'px';
      shell.style.maxWidth = maxOverlayWidth + 'px';
      shell.style.visibility = 'visible';
    }

    function showPreorderDatepicker(anchorButton) {
      const shell = document.getElementById('datepicker-shell');
      if (!shell) return;

      preorderDatepickerAnchor = anchorButton;
      movePreorderDatepickerShellToBody();

      shell.style.visibility = 'hidden';
      shell.classList.remove('is-hidden');
      shell.setAttribute('aria-hidden', 'false');

      positionPreorderDatepicker(anchorButton);
      window.requestAnimationFrame(function() {
        positionPreorderDatepicker(anchorButton);
      });
    }

    function hidePreorderDatepicker() {
      const $datepicker = $("#datepicker");
      const $datepickerShell = $("#datepicker-shell");

      if ($datepicker.data('datepicker')) {
        $datepicker.datepicker('destroy');
      }

      preorderDatepickerAnchor = null;
      $datepickerShell
        .addClass('is-hidden')
        .attr('aria-hidden', 'true')
        .css({
          left: '',
          top: '',
          visibility: ''
        });
    }

    function selectPreorderDate(dateText, currentTimeInMinutes, randomNum) {
      console.log('[Delivery Date] Date selected from Bootstrap datepicker:', dateText);

      sessionStorage.setItem("date", dateText);

      var today = new Date();
      var todayDateStr = ('0' + today.getDate()).slice(-2) + '-' +
                           ('0' + (today.getMonth() + 1)).slice(-2) + '-' +
                           today.getFullYear();

      const hasSameDayCutoff = typeof window.cutoffTimeInMinutes_samedayPreorderEndTime === 'number';

      if (
        hasSameDayCutoff &&
        currentTimeInMinutes >= window.cutoffTimeInMinutes_samedayPreorderEndTime &&
        window.b_additional_inventory === "Y" &&
        dateText === todayDateStr
      ) {
        sessionStorage.setItem("additional_inventory_time", "Y");
        console.log('[Delivery Date] Additional inventory time set to Y');
      }

      sessionStorage.setItem("immediate_inventory", "N");
      sessionStorage.setItem("snacks_and_drinks", "N");

      var newUrl = $(".preorderbtn").attr("href");
      const updateDateUrl = "https://dev.sushi.catering/updateSelectedDate/" + dateText;

      console.log('[Delivery Date] Updating selected preorder date at:', updateDateUrl);

      $.ajax({
        url: updateDateUrl,
        type: "GET",
        data: { "uuid": localStorage.getItem("uuid") },
        cache: false,
        async: true,
        dataType: "json",
        success: function(data) {
          const redirectUrl = newUrl + "?location=" + sessionStorage.getItem("location") + "&date=" + dateText + "&immediate_inventory=N&no_station=" + sessionStorage.getItem("no_station") + "&additional_inventory=" + sessionStorage.getItem("b_additional_inventory") + "&additional_inventory_time=" + sessionStorage.getItem("additional_inventory_time") + "&snacks_and_drinks=" + sessionStorage.getItem("snacks_and_drinks") + "&uuid=" + localStorage.getItem("uuid") + "&nocache=" + randomNum;
          console.log('[Delivery Date] Redirecting to preorder:', redirectUrl);
          window.location.href = redirectUrl;
        },
        error: function(request, status, error) {
          console.error('[Delivery Date] Error setting selected date (preorder):', {
            status,
            error
          });
