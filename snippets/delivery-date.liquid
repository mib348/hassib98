<style>
    .ui-datepicker {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1000; /* Adjust z-index as needed */
    }
    .ui-icon-circle-triangle-w, .ui-icon-circle-triangle-e{cursor:pointer;}

    /* Loading states for buttons */
    .btn-loading {
      opacity: 0.6;
      pointer-events: none;
      position: relative;
    }

    .btn-loading::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 16px;
      height: 16px;
      margin: -8px 0 0 -8px;
      border: 2px solid transparent;
      border-top: 2px solid currentColor;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    /*
      Badge counter mobile display fix -----------------------------------------
      Ensure the badge counter properly hides on mobile when display: none is applied
      by overriding any conflicting inline styles that might be set by syncBadgeCounterHeight()
    */
    #badge-counter[style*="display: none"] {
      display: none !important;
    }

    /*
      Yesterday badge counter mobile display fix --------------------------------
      Same fix for the yesterday items badge counter
    */
    #badge-counter-yesterday[style*="display: none"] {
      display: none !important;
    }

    /*
      Delivery controls container -------------------------------------------------
      Keep all delivery action buttons (today, preorder, snacks & drinks) tidy and
      readable by aligning them side by side, collapsing gracefully when space is
      tight so every option remains reachable on any screen width.
    */
    .delivery-buttons-container {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      justify-content: flex-start;
    }

    .__pf.__pf_GlDVGOc7 .pf-23_, .__pf.__pf_GlDVGOc7 .pf-27_{
      margin-left: 5px !important;
    }

    /*
      Delivery buttons base styling ----------------------------------------------
      Provide consistent sizing/spacing so the user instantly recognises all four
      actions. Inline-flex keeps icons/text centred while the compact padding makes
      the buttons feel lightweight without reducing the tap target below guidelines.
    */
    .preorderbtn,
    .todayorderbtn,
    .yesterdayorderbtn,
    .snacks_and_drinks_btn {
      display: none;
      align-items: center;
      justify-content: center;
      padding: 5px 10px;
      font-size: 14px;
      line-height: 1.1;
      min-height: 32px;
      font-weight: 500;
      transition: all 0.15s ease-out;
      white-space: nowrap;
      text-decoration: none;
      border: 1px solid transparent;
      cursor: pointer;
      box-sizing: border-box;
      position: relative;
    }

    /*
      Tablet behaviour ------------------------------------------------------------
      Tighten spacing slightly and ensure each button keeps a predictable width so
      the row stays visually balanced when content wraps on mid-sized devices.
    */
    @media (max-width: 768px) {
      .delivery-buttons-container {
        gap: 6px;
        justify-content: center;
      }

      .preorderbtn,
      .todayorderbtn,
      .yesterdayorderbtn,
      .snacks_and_drinks_btn {
        padding: 4px 8px;
        font-size: 13px;
        min-height: 30px;
        flex: 0 0 auto;
        min-width: 80px;
        margin: 0;
      }
    }

    /*
      Mobile stack ----------------------------------------------------------------
      When screens get narrow we stack the buttons so the user never needs to
      horizontally scroll. The centred layout keeps the call-to-action easy to
      discover for returning users. Vertical spacing matches horizontal gap for
      visual consistency when buttons wrap to new lines.
    */
    @media (max-width: 576px) {
      .delivery-buttons-container {
        gap: 6px;
        flex-direction: column;
        align-items: stretch;
      }

       .preorderbtn,
       .todayorderbtn,
       .yesterdayorderbtn,
       .snacks_and_drinks_btn {
         padding: 6px 10px;
         font-size: 14px;
         {% comment %} min-height: 36px; {% endcomment %}
         width: 100%;
         max-width: 200px;
         margin: 5px auto 0 auto !important;
         justify-content: center;
       }
    }

    /*
      Very small device refinement ------------------------------------------------
      Slightly reduce padding/letter spacing so long translated labels still fit
      cleanly without wrapping awkwardly on exceptionally narrow phones.
    */
    @media (max-width: 480px) {
      .preorderbtn,
      .todayorderbtn,
      .yesterdayorderbtn,
      .snacks_and_drinks_btn {
        padding: 5px 8px;
        font-size: 13px;
        {% comment %} min-height: 32px; {% endcomment %}
        margin-top: 5px !important;
        letter-spacing: -0.01em;
      }
    }

    @media (max-width: 360px) {
      .preorderbtn,
      .todayorderbtn,
      .yesterdayorderbtn,
      .snacks_and_drinks_btn {
        padding: 4px 6px;
        font-size: 12px;
        {% comment %} min-height: 28px; {% endcomment %}
        margin-top: 5px !important;
        letter-spacing: -0.02em;
      }
    }

    /*
      Touch optimisation ----------------------------------------------------------
      Give tablet/phone users a larger hit area so the buttons remain comfortable
      to tap, even when the browser hides hover styles by default.
    */
    @media (hover: none) and (pointer: coarse) {
      .preorderbtn,
      .todayorderbtn,
      .yesterdayorderbtn,
      .snacks_and_drinks_btn {
        {% comment %} min-height: 44px; {% endcomment %}
        padding: 8px 12px;
        margin-top: 5px !important;
      }

       @media (max-width: 576px) {
         .preorderbtn,
         .todayorderbtn,
         .yesterdayorderbtn,
         .snacks_and_drinks_btn {
           {% comment %} min-height: 48px; {% endcomment %}
           padding: 10px 14px;
           margin-top: 5px !important;
         }
       }
    }

    /* Button states */
    .preorderbtn:hover,
    .todayorderbtn:hover,
    .yesterdayorderbtn:hover,
    .snacks_and_drinks_btn:hover {
      transform: translateY(-1px);
      transition: all 0.1s ease-out;
    }

    .preorderbtn:active,
    .todayorderbtn:active,
    .yesterdayorderbtn:active,
    .snacks_and_drinks_btn:active {
      transform: translateY(0);
      transition: all 0.05s ease-out;
    }

    /* Focus states for accessibility */
    .preorderbtn:focus,
    .todayorderbtn:focus,
    .yesterdayorderbtn:focus,
    .snacks_and_drinks_btn:focus {
      outline: 2px solid currentColor;
      outline-offset: 2px;
    }
