          // (e.g., minDate != 1) but the yesterday items feature is enabled.
          // ALWAYS show button when 48h feature is enabled, with disabled state
          // and red zero badge when no items available.
          // =========================================================================
          if (data.immediate_inventory_48h === 'Y' && data.immediate_inventory === 'Y') {
            console.log('[Delivery Date] Yesterday items feature enabled (today btn not shown)');

            const yesterdayUrl = `https://dev.sushi.catering/getImmediateInventoryByLocationForYesterday/${window.deliveryDateState.location}`;

            $.ajax({
              url: yesterdayUrl,
              type: "GET",
              async: true,
              cache: true,
              dataType: "json",
              success: function(yesterdayQty) {
                console.log('[Delivery Date] Yesterday inventory count:', yesterdayQty);

                setYesterdayDisplay(true);
                const buttonYesterdayOrder = document.querySelector('.yesterdayorderbtn');

                if (yesterdayQty > 0) {
                  // Items available: enable button with green badge
                  if (buttonYesterdayOrder) {
                    setActionButtonDisabled(buttonYesterdayOrder, false);
                  }
                  $('#badge-counter-yesterday')
                    .html(yesterdayQty)
                    .removeClass('text-bg-danger')
                    .addClass('text-bg-success')
                    .addClass('yesterday-inline-flex')
                    .removeClass('yesterday-hidden');
                  console.log('[Delivery Date] Yesterday button enabled with qty:', yesterdayQty);
                } else {
                  // No items: disable button but show red zero badge
                  if (buttonYesterdayOrder) {
                    setActionButtonDisabled(buttonYesterdayOrder, true, 'Keine Artikel verfügbar');
                  }
                  $('#badge-counter-yesterday')
                    .html(0)
                    .removeClass('text-bg-success')
                    .addClass('text-bg-danger')
                    .addClass('yesterday-inline-flex')
                    .removeClass('yesterday-hidden');
                  console.log('[Delivery Date] Yesterday button disabled - showing red zero');
                }
              },
              error: function(request, status, error) {
