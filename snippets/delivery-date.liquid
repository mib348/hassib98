          } else {
            // Feature not enabled - ensure yesterday button is hidden
            console.log('[Delivery Date] Yesterday items feature NOT enabled');
            setYesterdayDisplay(false);
          }
        }
      } else {
        console.log('[Delivery Date] Location is NOT active, hiding buttons');
        $('#badge-counter').css('display', 'none');
        setYesterdayDisplay(false);
        const buttonTodayOrder = document.querySelector('.todayorderbtn');
