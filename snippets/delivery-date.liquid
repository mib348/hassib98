    // Setup button click handlers
    function setupButtonHandlers() {
      console.log('[Delivery Date] setupButtonHandlers called');

      if (!window.jQuery) {
        console.error('[Delivery Date] jQuery not available for button handlers');
        return;
      }

      let $ = window.jQuery;
      const randomNum = Math.random();

      console.log('[Delivery Date] Random number for cache busting:', randomNum);

      $(".todayorderbtn, .preorderbtn").each(function() {
        // Reset any inline styles that might have been applied to indicate disabled state
        this.style.pointerEvents = '';
        this.style.opacity = '';
      });

      var button = $(".preorderbtn");
      var buttonOffset = button.offset();

      // Calculate new top and left positions
      var newTop = buttonOffset.top + button.outerHeight();
      var newLeft = buttonOffset.left;

      console.log('[Delivery Date] Preorder button offset:', { newTop, newLeft });

      // Use Intl.DateTimeFormat to get the correct current date in Germany
      const options = {
        timeZone: 'Europe/Berlin',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour12: false
      };

      const formatter = new Intl.DateTimeFormat([], options);
      const parts = formatter.formatToParts(new Date());

      let dateObj = {};
      parts.forEach(({ type, value }) => {
        dateObj[type] = value;
      });

      var today = `${dateObj.day}-${dateObj.month}-${dateObj.year}`;

      console.log('[Delivery Date] Today\'s date:', today);

      hidePreorderDatepicker();

      $(".todayorderbtn").click(function(e){
        e.preventDefault();

        console.log('[Delivery Date] Today order button clicked');

        var href = $(this).attr("href");

        console.log('[Delivery Date] Today order href:', href);

        // Set session storage for today's order
        // strYStockOnlyCheck = N means we're ordering TODAY's items (not yesterday's)
        sessionStorage.setItem("date", today);
        sessionStorage.setItem("immediate_inventory", "Y");
        sessionStorage.setItem("snacks_and_drinks", "N");
        sessionStorage.setItem("strYStockOnlyCheck", "N"); // Track that this is TODAY's order

        // Update global state to track which button was clicked
        window.deliveryDateState.strYStockOnlyCheck = "N";

        console.log('[Delivery Date] SessionStorage set for today order:', {
          date: today,
          immediate_inventory: "Y",
          snacks_and_drinks: "N",
          strYStockOnlyCheck: "N"
        });

        const updateDateUrl = "https://dev.sushi.catering/updateSelectedDate/" + today;
        console.log('[Delivery Date] Updating selected date at:', updateDateUrl);

        $.ajax({
          url: updateDateUrl,
          type: "GET",
          data: {"uuid": localStorage.getItem("uuid")},
          cache: false,
          async: true, // Changed from false to true
          dataType: "json",
          success: function(data) {
            // strYStockOnlyCheck is always "N" for today button - yesterday has its own button now
            const redirectUrl = href + "?location=" + sessionStorage.getItem("location") + "&date=" + today + "&immediate_inventory=Y&no_station=" + sessionStorage.getItem("no_station") + "&snacks_and_drinks=" + sessionStorage.getItem("snacks_and_drinks") + "&uuid=" + localStorage.getItem("uuid") + "&strYStockOnlyCheck=N&nocache=" + randomNum;
            console.log('[Delivery Date] Redirecting to:', redirectUrl);
            window.location.href = redirectUrl;
          },
          error: function(request, status, error) {
            console.error('[Delivery Date] Error setting selected date (today):', {
              status,
              error
            });
            alert('Fehler beim Einstellen des ausgewählten Datums. Bitte versuchen Sie es nach dem Aktualisieren der Seite erneut.');
          }
        });
      });

      // =========================================================================
      // YESTERDAY ORDER BUTTON CLICK HANDLER
      // =========================================================================
      // This handler is for the "Sofortbestellung Gestern" (Immediate Order Yesterday) button.
      //
      // KEY BEHAVIOR:
      // - Passes TODAY'S date in the URL and sessionStorage (customer picks up TODAY)
      // - Sets strYStockOnlyCheck=Y to signal "show yesterday's inventory"
      // - dynamic-location-inventory.liquid reads strYStockOnlyCheck=Y and sets line item property yesterday_item=Y
      // - Backend (OrdersCreateJob) reads yesterday_item=Y and deducts inventory from yesterday's date
      // - Order's pick_up_date remains TODAY (already correct for Raspberry Pi door access)
      //
      // FLOW:
      // 1. User clicks yesterday button
      // 2. Date = TODAY, strYStockOnlyCheck = Y
      // 3. Liquid template shows products from yesterday's inventory
      // 4. Line item property yesterday_item = Y is added to cart
      // 5. Order created with pick_up_date = TODAY
      // 6. Backend deducts inventory from yesterday's date metafield
      // =========================================================================
      $(".yesterdayorderbtn").click(function(e){
        e.preventDefault();

        if (isActionButtonDisabled(this)) {
          console.log('[Delivery Date] Yesterday order button is disabled, click ignored');
          return;
        }

        console.log('[Delivery Date] Yesterday order button clicked');

        var href = $(this).attr("href");

        console.log('[Delivery Date] Using TODAY\'s date for yesterday items:', today);

        // =====================================================================
        // Set session storage values for yesterday order
        // =====================================================================
        // IMPORTANT: We use TODAY's date (when customer picks up), not yesterday's date
        // strYStockOnlyCheck=Y signals to show yesterday's inventory in the product list
        // The line item property yesterday_item=Y will be set by dynamic-location-inventory.liquid
        // =====================================================================
        sessionStorage.setItem("date", today);
        sessionStorage.setItem("immediate_inventory", "Y");
        sessionStorage.setItem("snacks_and_drinks", "N");
        sessionStorage.setItem("strYStockOnlyCheck", "Y"); // Signal: show yesterday's inventory

        // Update global state to track which button was clicked
        window.deliveryDateState.strYStockOnlyCheck = "Y";

        console.log('[Delivery Date] SessionStorage set for yesterday order:', {
          date: today,
          immediate_inventory: "Y",
          snacks_and_drinks: "N",
          strYStockOnlyCheck: "Y"
        });

        // Update selected date on server with TODAY's date
        const updateDateUrl = "https://dev.sushi.catering/updateSelectedDate/" + today;
        console.log('[Delivery Date] Updating selected date at:', updateDateUrl);

        $.ajax({
          url: updateDateUrl,
          type: "GET",
          data: {"uuid": localStorage.getItem("uuid")},
          cache: false,
          async: true,
          dataType: "json",
          success: function(data) {
            // Redirect to order menu with TODAY's date
            // strYStockOnlyCheck=Y ensures only yesterday's items are shown
            const redirectUrl = href + "?location=" + sessionStorage.getItem("location") +
              "&date=" + today +
              "&immediate_inventory=Y" +
              "&no_station=" + sessionStorage.getItem("no_station") +
              "&snacks_and_drinks=N" +
              "&uuid=" + localStorage.getItem("uuid") +
              "&strYStockOnlyCheck=Y" +
              "&nocache=" + randomNum;

            console.log('[Delivery Date] Redirecting to yesterday order with today\'s date:', redirectUrl);
            window.location.href = redirectUrl;
          },
          error: function(request, status, error) {
            console.error('[Delivery Date] Error setting selected date (yesterday):', {
              status,
              error
            });
            alert('Fehler beim Einstellen des ausgewählten Datums. Bitte versuchen Sie es nach dem Aktualisieren der Seite erneut.');
          }
        });
      });

      $(".snacks_and_drinks_btn").click(function(e){
        e.preventDefault();

        console.log('[Delivery Date] Snacks and drinks button clicked');

        var newUrl = $(".snacks_and_drinks_btn").attr("href");
        var today = `${dateObj.day}-${dateObj.month}-${dateObj.year}`;

        sessionStorage.setItem("snacks_and_drinks", "Y");
        sessionStorage.setItem("immediate_inventory", "N");
        sessionStorage.setItem("no_station", "N");
        sessionStorage.setItem("additional_inventory", "N");
        sessionStorage.setItem("additional_inventory_time", "N");

        console.log('[Delivery Date] SessionStorage set for snacks and drinks:', {
          snacks_and_drinks: "Y",
          immediate_inventory: "N",
          no_station: "N",
          additional_inventory: "N",
          additional_inventory_time: "N"
        });

        const redirectUrl = newUrl + "?location=" + sessionStorage.getItem("location") + "&date=" + today + "&snacks_and_drinks=" + sessionStorage.getItem("snacks_and_drinks") + "&immediate_inventory=" + sessionStorage.getItem("immediate_inventory") + "&no_station=" + sessionStorage.getItem("no_station") + "&additional_inventory=" + sessionStorage.getItem("b_additional_inventory") + "&additional_inventory_time=" + sessionStorage.getItem("additional_inventory_time") + "&uuid=" + localStorage.getItem("uuid") + "&nocache=" + randomNum;

        console.log('[Delivery Date] Redirecting to snacks and drinks:', redirectUrl);
        window.location.href = redirectUrl;
      });

      $(".preorderbtn").click(function(e){
        e.preventDefault();

        console.log('[Delivery Date] Preorder button clicked');

        if (window.accept_only_preorders === "Y" && (typeof window.samedayPreorderEndTime === 'undefined' || !window.samedayPreorderEndTime)) {
          console.warn('[Delivery Date] Same-day preorder end time is not set');
          //return;
        }
        if (window.b_additional_inventory == "Y" && (typeof window.additionalInventoryPreorderEndTime === 'undefined' || !window.additionalInventoryPreorderEndTime)) {
          console.warn('[Delivery Date] Additional Inventory end time is not set');
          //return;
        }

        // Get the current date and time in Germany
        const now = new Date();
        const options = {
          timeZone: 'Europe/Berlin',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false
        };
        const formatter = new Intl.DateTimeFormat('en-GB', options);
        const parts = formatter.formatToParts(now);

        let dateObj = {};
        parts.forEach(({ type, value }) => {
          dateObj[type] = value;
        });

        let minDate = 0; // Default to today
        sessionStorage.setItem("additional_inventory_time", "N");

        const currentHours = parseInt(dateObj.hour, 10);
        const currentMinutes = parseInt(dateObj.minute, 10);
        const currentTimeInMinutes = currentHours * 60 + currentMinutes;

        console.log('[Delivery Date] Preorder current time:', {
          hours: currentHours,
          minutes: currentMinutes,
          totalMinutes: currentTimeInMinutes
        });

        // Parse the same-day preorder end time
        if(window.samedayPreorderEndTime){
          const [cutoffHours_samedayPreorderEndTime, cutoffMinutes_samedayPreorderEndTime] = window.samedayPreorderEndTime.split(':').map(Number);
          window.cutoffTimeInMinutes_samedayPreorderEndTime = cutoffHours_samedayPreorderEndTime * 60 + cutoffMinutes_samedayPreorderEndTime;
          console.log('[Delivery Date] Sameday cutoff minutes:', window.cutoffTimeInMinutes_samedayPreorderEndTime);
        }

        // Compare current time with cutoff time
        if(window.additionalInventoryPreorderEndTime){
          const [cutoffHours_Additionalnventory, cutoffMinutes_Additionalnventory] = window.additionalInventoryPreorderEndTime.split(':').map(Number);
          window.cutoffTimeInMinutes_Additionalnventory = cutoffHours_Additionalnventory * 60 + cutoffMinutes_Additionalnventory;
          console.log('[Delivery Date] Additional inventory cutoff minutes:', window.cutoffTimeInMinutes_Additionalnventory);
        }

        if (window.additionalInventoryPreorderEndTime && currentTimeInMinutes >= cutoffTimeInMinutes_Additionalnventory && window.b_additional_inventory === "Y") {
          minDate = 1; // Set minDate to tomorrow
          console.log('[Delivery Date] After additional inventory cutoff, minDate set to 1');
        }
        else if (window.samedayPreorderEndTime && currentTimeInMinutes >= cutoffTimeInMinutes_samedayPreorderEndTime && window.b_additional_inventory === "N") {
          minDate = 1; // Set minDate to tomorrow
          console.log('[Delivery Date] After sameday cutoff (no additional inventory), minDate set to 1');
        }

        console.log('[Delivery Date] Initializing datepicker with minDate:', minDate);

        const $datepicker = $("#datepicker");
        const preorderButton = this;

        hidePreorderDatepicker();
        showPreorderDatepicker(preorderButton);

        /*
          bootstrap-datepicker uses startDate/endDate/format and emits changeDate.
          This replaces the old jQuery UI minDate/maxDate/dateFormat/onSelect API
          while keeping the same dd-mm-yyyy value that the order flow expects.
        */
        $datepicker
          .datepicker({
            format: "dd-mm-yyyy",
            startDate: minDate === 1 ? "+1d" : "0d",
            endDate: "+6d",
            language: "de",
            weekStart: 1,
            todayHighlight: true,
            autoclose: true,
            startView: 0,
            maxViewMode: 0,
            zIndexOffset: 1080
          })
          .off('changeDate.deliveryDate')
          .on('changeDate.deliveryDate', function() {
            const dateText = $datepicker.datepicker('getFormattedDate');
            hidePreorderDatepicker();
            selectPreorderDate(dateText, currentTimeInMinutes, randomNum);
          })
          .datepicker('show');

        positionPreorderDatepicker(preorderButton);
        window.requestAnimationFrame(function() {
          positionPreorderDatepicker(preorderButton);
          $('#datepicker-shell .datepicker-switch')
            .attr('aria-disabled', 'true')
            .attr('title', 'Jahreswechsel deaktiviert');
        });

        console.log('[Delivery Date] Bootstrap datepicker shown');
      });
      
      // Add click handler to hide datepicker when clicking outside
      $(document).on('click', function(e) {
        if (!$(e.target).closest('#datepicker-shell, .preorderbtn, .datepicker').length && !$('#datepicker-shell').hasClass('is-hidden')) {
          hidePreorderDatepicker();
        }
      });

      $(window).on('resize.deliveryDate orientationchange.deliveryDate scroll.deliveryDate', function() {
        if (preorderDatepickerAnchor) {
          positionPreorderDatepicker(preorderDatepickerAnchor);
        }
      });
    }
  
    function toggleButton(startTime, endTime) {
      const now = new Date();
      
      // Use Intl.DateTimeFormat to get the correct current time in Germany
      const options = {
        timeZone: 'Europe/Berlin',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour12: false
      };
      
      const formatter = new Intl.DateTimeFormat([], options);
      const parts = formatter.formatToParts(now);
      
      let dateObj = {};
      parts.forEach(({ type, value }) => {
        dateObj[type] = value;
      });
      
      const timeGermany = new Date(`${dateObj.year}-${dateObj.month}-${dateObj.day}T${dateObj.hour}:${dateObj.minute}:${dateObj.second}`);
      
      const currentHours = timeGermany.getHours();
      const currentMinutes = timeGermany.getMinutes();
      
      const [startHours, startMinutes] = startTime.split(':').map(Number);
      let [endHours, endMinutes] = endTime.split(':').map(Number);
      
      // Adjust for end time being 00:00 (midnight)
      if (endHours === 0 && endMinutes === 0) {
        endHours = 24;
      }
      
      const currentTimeInMinutes = currentHours * 60 + currentMinutes;
      const startTimeInMinutes = startHours * 60 + startMinutes;
      const endTimeInMinutes = endHours * 60 + endMinutes;
      
      const isWithinTimeSlot = currentTimeInMinutes >= startTimeInMinutes && currentTimeInMinutes < endTimeInMinutes;
        {% comment %} alert(isWithinTimeSlot + "-" + currentTimeInMinutes + "-" +startTimeInMinutes + "-" +endTimeInMinutes); {% endcomment %}
      
      const buttonTodayOrder = document.querySelector('.todayorderbtn');
      {% comment %} if (isWithinTimeSlot) {
        if (buttonTodayOrder) buttonTodayOrder.classList.add('show-button');
        $('#badge-counter').css('display', 'inline-block');
      } else {
        if (buttonTodayOrder) buttonTodayOrder.classList.remove('show-button');
        $('#badge-counter').css('display', 'none');
      } {% endcomment %}
      if (buttonTodayOrder) buttonTodayOrder.classList.add('show-button');
      $('#badge-counter').css('display', 'inline-block');
    }
  
    // DOM Content Loaded - Handle location determination
    document.addEventListener('DOMContentLoaded', function() {
      window.deliveryDateState.domReady = true;
      
      // --- Start of the refined location handling logic ---
      let determinedLocation = null;
  
      // 1. First priority: Try to get from URL parameters
      const queryParams = new URLSearchParams(window.location.search);
      const urlLocation = queryParams.get('location');
      if (urlLocation && urlLocation.trim() !== "") {
        determinedLocation = urlLocation.trim();
        // Set it in sessionStorage for future use within the session
        sessionStorage.setItem("location", determinedLocation);
        console.log("Location: Set from URL param to sessionStorage:", determinedLocation);
      }
  
      // 2. If not in URL, try to get from sessionStorage first (prioritized)
      if (!determinedLocation) {
        const ssLocation = sessionStorage.getItem("location");
        if (ssLocation && ssLocation.trim() !== "") {
          determinedLocation = ssLocation.trim();
          console.log("Location: Found in sessionStorage:", determinedLocation);
        }
      }
  
      // 3. If not in URL or sessionStorage, try to get from localStorage
      if (!determinedLocation) {
        const lsLocation = localStorage.getItem("location");
        if (lsLocation && lsLocation.trim() !== "") {
          determinedLocation = lsLocation.trim();
          // Ensure sessionStorage is also set if localStorage had it
          if (sessionStorage.getItem("location") !== determinedLocation) {
            sessionStorage.setItem("location", determinedLocation);
            console.log("Location: Set from localStorage to sessionStorage:", determinedLocation);
          }
        }
      }
  
      // Store the determined location
      window.deliveryDateState.location = determinedLocation || "";
      wrapImmediateButtonsForMobile();
      
      // Try to initialize if jQuery is already available
      initializeDeliveryDate();
    });
  
    // Window load - Handle jQuery and full page load
    window.addEventListener('load', function() {
      // Check if jQuery is available
      if (window.jQuery) {
        console.log('jQuery is ready');
        waitForBootstrapDatepicker();
      } else {
        // Wait for jQuery to be available
        const checkJQuery = setInterval(function() {
          if (window.jQuery) {
            console.log('jQuery became available');
            clearInterval(checkJQuery);
            waitForBootstrapDatepicker();
          }
        }, 100);
        
        // Timeout after 10 seconds
        setTimeout(function() {
          if (!window.deliveryDateState.jqueryReady) {
            clearInterval(checkJQuery);
            console.error('jQuery failed to load within 10 seconds');
            removeLoadingStates();
          }
        }, 10000);
      }
    });

    // Handle window resize to re-sync badge counter height
    window.addEventListener('resize', function() {
      if (window.deliveryDateState.isInitialized) {
        syncBadgeCounterHeight();
        wrapImmediateButtonsForMobile();
      }
    });
  </script>
  
