  <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.9.2/jquery-ui.min.js" defer="defer"></script>
  
  <div id="datepicker"></div>
  <br>
  <br>
  <br>
  
  <script>
    // Global state management
    window.deliveryDateState = {
      isInitialized: false,
      location: null,
      locationData: null,
      jqueryReady: false,
      domReady: false,
      strYStockOnlyCheck: "N"
    };
  
    // Initialize everything when ready
    function initializeDeliveryDate() {
      console.log('[Delivery Date] initializeDeliveryDate called', {
        isInitialized: window.deliveryDateState.isInitialized,
        domReady: window.deliveryDateState.domReady,
        jqueryReady: window.deliveryDateState.jqueryReady
      });

      if (window.deliveryDateState.isInitialized) {
        console.log('[Delivery Date] Already initialized, skipping');
        return;
      }

      // Check if all dependencies are ready
      if (!window.deliveryDateState.domReady || !window.deliveryDateState.jqueryReady) {
        console.log('[Delivery Date] Dependencies not ready yet', {
          domReady: window.deliveryDateState.domReady,
          jqueryReady: window.deliveryDateState.jqueryReady
        });
        return;
      }

      console.log('[Delivery Date] All dependencies ready, initializing functionality...');

      const buttonTodayOrder = document.querySelector('.todayorderbtn');
      const buttonPreOrder = document.querySelector('.preorderbtn');
      const buttonSnacksAndDrinks = document.querySelector('.snacks_and_drinks_btn');
      const buttonYesterdayOrder = document.querySelector('.yesterdayorderbtn');

      console.log('[Delivery Date] Buttons found:', {
        todayOrderBtn: !!buttonTodayOrder,
        preOrderBtn: !!buttonPreOrder,
        snacksAndDrinksBtn: !!buttonSnacksAndDrinks,
        yesterdayOrderBtn: !!buttonYesterdayOrder
      });

      // Add loading state to buttons initially
      if (buttonTodayOrder) buttonTodayOrder.classList.add('btn-loading');
      if (buttonPreOrder) buttonPreOrder.classList.add('btn-loading');
      if (buttonSnacksAndDrinks) buttonSnacksAndDrinks.classList.add('btn-loading');
      if (buttonYesterdayOrder) buttonYesterdayOrder.classList.add('btn-loading');

      // Sync badge counter height with buttons on small devices
      syncBadgeCounterHeight();

      // Process location and setup functionality
      processLocationAndSetup();

      window.deliveryDateState.isInitialized = true;
      console.log('[Delivery Date] Initialization complete');
    }

    // Sync badge counter height with buttons on small devices
    function syncBadgeCounterHeight() {
      const badgeCounter = document.getElementById('badge-counter');
      if (!badgeCounter) return;
      
      // Only apply on small devices (576px and below)
      if (window.innerWidth <= 576) {
        const button = document.querySelector('.preorderbtn, .todayorderbtn, .snacks_and_drinks_btn');
        if (button) {
          const computedStyle = window.getComputedStyle(button);
          const buttonPadding = computedStyle.padding;
          const buttonMinHeight = computedStyle.minHeight;
          
          // Apply same padding and min-height to badge counter
          // Note: Do not set display property here as it interferes with toggleButton() visibility control
          badgeCounter.style.padding = buttonPadding;
          badgeCounter.style.minHeight = buttonMinHeight;
          badgeCounter.style.boxSizing = 'border-box';
          badgeCounter.style.alignItems = 'center';
          badgeCounter.style.justifyContent = 'center';
        }
      }
    }

    // =========================================================================
    // UPDATE TODAY BADGE COUNTER
    // =========================================================================
    // Shows ONLY today's inventory count on the "Sofortbestellung" (Today) button.
    // The API getImmediateInventoryByLocation now returns ONLY today's inventory
    // (not combined). Yesterday's inventory is shown separately on its own button.
    // strYStockOnlyCheck is always "N" for today button since yesterday has its own.
    // =========================================================================
    function updateTodayBadgeCounter(location) {
      console.log('[Delivery Date] updateTodayBadgeCounter called for location:', location);

      // Always set to "N" for today button - yesterday has its own button now
      window.deliveryDateState.strYStockOnlyCheck = "N";

      // Helper to update the badge display with a quantity
      function updateBadgeDisplay(qty) {
        console.log('[Delivery Date] Today badge display updated with qty:', qty);
        if (qty > 0) {
          $('#badge-counter')
            .html(qty)
            .removeClass('text-bg-danger')
            .addClass('text-bg-success')
            .css('display', 'inline-block');
        } else {
          $('#badge-counter')
            .html(0)
            .removeClass('text-bg-success')
            .addClass('text-bg-danger')
            .css('display', 'inline-block');
        }
      }

      // =========================================================================
      // FETCH TODAY'S INVENTORY ONLY
      // The API now returns ONLY today's inventory (not combined with yesterday).
      // No calculation needed - just display the returned value directly.
      // =========================================================================
      const todayUrl = `https://dev.sushi.catering/getImmediateInventoryByLocation/${location}`;
      console.log('[Delivery Date] Fetching today-only inventory from:', todayUrl);

      $.ajax({
        url: todayUrl,
        type: "GET",
        async: true,
        cache: false,  // Don't cache to ensure fresh data
        dataType: "json",
        success: function(todayQty) {
          console.log('[Delivery Date] Today inventory received:', todayQty);
          updateBadgeDisplay(todayQty);
        },
        error: function(request, status, error) {
          console.error('[Delivery Date] Error fetching today inventory:', error);
          updateBadgeDisplay(0);
        }
      });
    }
  
    // Process location and setup all functionality
    function processLocationAndSetup() {
      const strLocation = window.deliveryDateState.location || "";

      console.log('[Delivery Date] processLocationAndSetup called with location:', strLocation);

      if (strLocation === "") {
        console.log('[Delivery Date] No location available, skipping initialization');
        removeLoadingStates();
        return;
      }

      $("#badge-counter").html('<img src="https://raw.githubusercontent.com/Codelessly/FlutterLoadingGIFs/master/packages/cupertino_activity_indicator_square_large.gif" height="21px" width="21px" class="loading_icon" />');

      const ajaxUrl = `https://dev.sushi.catering/getLocations/${strLocation}`;
      console.log('[Delivery Date] Fetching location data from:', ajaxUrl);

      // Make AJAX call asynchronous to prevent UI blocking
      $.ajax({
        url: ajaxUrl,
        type: "GET",
        async: true, // Changed from false to true
        cache: true,
        dataType: "json",
        success: function(data) {
          console.log('[Delivery Date] Location data received:', data);
          window.deliveryDateState.locationData = data;
          setupLocationData(data);
          setupButtonHandlers();
          removeLoadingStates();
          
          // Re-sync badge counter height after buttons are shown
          syncBadgeCounterHeight();
        },
        error: function(request, status, error) {
          console.error('[Delivery Date] Error fetching location data:', {
            status,
            error,
            url: ajaxUrl
          });
          removeLoadingStates();
        }
      });
    }
  
    // Setup location-specific data
    function setupLocationData(data) {
      console.log('[Delivery Date] setupLocationData called with data:', data);

      // Save the same-day preorder end time
      window.samedayPreorderEndTime = data.sameday_preorder_end_time;
      window.firstAdditionalInventoryPreorderEndTime = data.first_additional_inventory_end_time;
      window.additionalInventoryPreorderEndTime = data.second_additional_inventory_end_time;
      window.immediate_inventory_quantity_check_time = data.immediate_inventory_quantity_check_time;
      window.b_additional_inventory = data.additional_inventory;
      window.accept_only_preorders = data.accept_only_preorders;
      window.immediate_inventory = data.immediate_inventory;

      console.log('[Delivery Date] Window variables set:', {
        samedayPreorderEndTime: window.samedayPreorderEndTime,
        firstAdditionalInventoryPreorderEndTime: window.firstAdditionalInventoryPreorderEndTime,
        additionalInventoryPreorderEndTime: window.additionalInventoryPreorderEndTime,
        immediate_inventory_quantity_check_time: window.immediate_inventory_quantity_check_time,
        b_additional_inventory: window.b_additional_inventory,
        accept_only_preorders: window.accept_only_preorders,
        immediate_inventory: window.immediate_inventory
      });

      sessionStorage.setItem("no_station", data.no_station);
      sessionStorage.setItem("b_additional_inventory", data.additional_inventory);
      sessionStorage.setItem("immediate_inventory", data.immediate_inventory);

      console.log('[Delivery Date] SessionStorage updated:', {
        no_station: data.no_station,
        b_additional_inventory: data.additional_inventory,
        immediate_inventory: data.immediate_inventory
      });

      if(data.driver_fulfillment_time){
        $(".status-delivery-today span").html(data.driver_fulfillment_time).css("color", "limegreen");
        console.log('[Delivery Date] Driver fulfillment time set:', data.driver_fulfillment_time);
      } else {
        $(".status-delivery-today span").html("noch nicht erfolgt").css("color", "red");
        console.log('[Delivery Date] No driver fulfillment time available');
      }

      // Get the current date and time in Germany
      const now = new Date();
      const options = {
        timeZone: 'Europe/Berlin',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
      };
      const formatter = new Intl.DateTimeFormat('en-GB', options);
      const parts = formatter.formatToParts(now);

      let dateObj = {};
      parts.forEach(({ type, value }) => {
        dateObj[type] = value;
      });

      let minDate = 0; // Default to today

      const currentHours = parseInt(dateObj.hour, 10);
      const currentMinutes = parseInt(dateObj.minute, 10);
      const currentTimeInMinutes = currentHours * 60 + currentMinutes;

      console.log('[Delivery Date] Current time in Germany:', {
        hours: currentHours,
        minutes: currentMinutes,
        totalMinutes: currentTimeInMinutes
      });

      // Parse the same-day preorder end time
      if(window.samedayPreorderEndTime){
        const [cutoffHours_samedayPreorderEndTime, cutoffMinutes_samedayPreorderEndTime] = window.samedayPreorderEndTime.split(':').map(Number);
        window.cutoffTimeInMinutes_samedayPreorderEndTime = cutoffHours_samedayPreorderEndTime * 60 + cutoffMinutes_samedayPreorderEndTime;

        console.log('[Delivery Date] Sameday preorder cutoff:', {
          time: window.samedayPreorderEndTime,
          cutoffMinutes: window.cutoffTimeInMinutes_samedayPreorderEndTime
        });

        if (window.samedayPreorderEndTime && currentTimeInMinutes >= cutoffTimeInMinutes_samedayPreorderEndTime) {
          minDate = 1;
          console.log('[Delivery Date] After sameday cutoff, minDate set to 1 (tomorrow)');
        }
      }

      if (data.note) {
        $("#note").html(data.note);
        console.log('[Delivery Date] Note displayed:', data.note);
      }

      if(data.snacks_and_drinks != "Y"){
        const buttonSnacksAndDrinks = document.querySelector('.snacks_and_drinks_btn');
        if (buttonSnacksAndDrinks) buttonSnacksAndDrinks.classList.remove('show-button');
        $('.snacks_and_drinks_btn').css('display', 'none');
      }
      else{
        const buttonSnacksAndDrinks = document.querySelector('.snacks_and_drinks_btn');
        if (buttonSnacksAndDrinks) buttonSnacksAndDrinks.classList.add('show-button');
        $('.snacks_and_drinks_btn').css('display', 'inline-flex');
      }

      // Handle location_toggle state
      if (data.is_active === 'Y') {
        console.log('[Delivery Date] Location is active, setting up buttons');
        const buttonTodayOrder = document.querySelector('.todayorderbtn');
        const buttonPreOrder = document.querySelector('.preorderbtn');

        buttonPreOrder.classList.add('show-button');
        console.log('[Delivery Date] Preorder button shown');

        //today order button aka immediate order button aka instant order button
        if (data.start_time && data.end_time && data.is_active === 'Y' && data.accept_only_preorders === 'N' && data.immediate_inventory == "Y" && minDate == 1) {
          console.log('[Delivery Date] Today order button conditions met:', {
            start_time: data.start_time,
            end_time: data.end_time,
            is_active: data.is_active,
            accept_only_preorders: data.accept_only_preorders,
            immediate_inventory: data.immediate_inventory,
            minDate: minDate
          });

          toggleButton(data.start_time, data.end_time);
          setInterval(() => {toggleButton(data.start_time, data.end_time);}, 60000);

          // =========================================================================
          // CONSOLIDATED INVENTORY FETCH
          // Fetch yesterday's inventory ONCE and use it for:
          // 1. Today badge: combined - yesterday = today's inventory only
          // 2. Yesterday button: show if yesterdayQty > 0 (when 48h feature enabled)
          // This eliminates the duplicate AJAX call that was happening before.
          // =========================================================================
          const is48hFeatureEnabled = data.immediate_inventory_48h === 'Y';
          console.log('[Delivery Date] 48h feature (yesterdays items) enabled:', is48hFeatureEnabled);

          if (is48hFeatureEnabled) {
            // Fetch yesterday qty, then use it for both badges
            const yesterdayUrl = `https://dev.sushi.catering/getImmediateInventoryByLocationForYesterday/${window.deliveryDateState.location}`;
            console.log('[Delivery Date] Fetching yesterday inventory from:', yesterdayUrl);

            $.ajax({
              url: yesterdayUrl,
              type: "GET",
              async: true,
              cache: true,
              dataType: "json",
              success: function(yesterdayQty) {
                console.log('[Delivery Date] Yesterday inventory received:', yesterdayQty);

                // Update TODAY badge (API now returns only today's inventory)
                updateTodayBadgeCounter(window.deliveryDateState.location);

                // Update YESTERDAY badge and button visibility
                const buttonYesterdayOrder = document.querySelector('.yesterdayorderbtn');
                if (yesterdayQty > 0) {
                  // Show the yesterday order button and badge
                  if (buttonYesterdayOrder) {
                    buttonYesterdayOrder.classList.add('show-button');
                    $('.yesterdayorderbtn').css('display', 'inline-flex');
                  }
                  $('#badge-counter-yesterday')
                    .html(yesterdayQty)
                    .removeClass('text-bg-danger')
                    .addClass('text-bg-success')
                    .css('display', 'inline-block');
                  console.log('[Delivery Date] Yesterday button shown with qty:', yesterdayQty);
                } else {
                  // No yesterday items - hide button and badge
                  if (buttonYesterdayOrder) {
                    buttonYesterdayOrder.classList.remove('show-button');
                    $('.yesterdayorderbtn').css('display', 'none');
                  }
                  $('#badge-counter-yesterday').css('display', 'none');
                  console.log('[Delivery Date] Yesterday button hidden - no items available');
                }

                // Set up interval to refresh both badges every minute
                setInterval(() => {
                  console.log('[Delivery Date] Refreshing inventory badges...');
                  // Re-fetch yesterday qty for updated badges
                  $.ajax({
                    url: yesterdayUrl,
                    type: "GET",
                    async: true,
                    cache: false, // Don't cache on refresh
                    dataType: "json",
                    success: function(newYesterdayQty) {
                      // Update today badge (API returns only today's inventory)
                      updateTodayBadgeCounter(window.deliveryDateState.location);
                      // Update yesterday badge
                      if (newYesterdayQty > 0) {
                        $('#badge-counter-yesterday')
                          .html(newYesterdayQty)
                          .removeClass('text-bg-danger')
                          .addClass('text-bg-success')
                          .css('display', 'inline-block');
                      } else {
                        $('#badge-counter-yesterday')
                          .html(0)
                          .removeClass('text-bg-success')
                          .addClass('text-bg-danger')
                          .css('display', 'inline-block');
                      }
                    }
                  });
                }, 60000);
              },
              error: function(request, status, error) {
                console.error('[Delivery Date] Error fetching yesterday inventory:', error);
                // Fallback: still show today's inventory on error
                updateTodayBadgeCounter(window.deliveryDateState.location);
                // Hide yesterday button on error
                const buttonYesterdayOrder = document.querySelector('.yesterdayorderbtn');
                if (buttonYesterdayOrder) {
                  buttonYesterdayOrder.classList.remove('show-button');
                  $('.yesterdayorderbtn').css('display', 'none');
                }
                $('#badge-counter-yesterday').css('display', 'none');
              }
            });
          } else {
            // 48h feature disabled - just show today's inventory on today badge
            console.log('[Delivery Date] 48h feature disabled, showing today inventory only');
            updateTodayBadgeCounter(window.deliveryDateState.location);

            // Set up interval for today badge refresh
            setInterval(() => {
              updateTodayBadgeCounter(window.deliveryDateState.location);
            }, 60000);

            // Ensure yesterday button is hidden
            const buttonYesterdayOrder = document.querySelector('.yesterdayorderbtn');
            if (buttonYesterdayOrder) {
              buttonYesterdayOrder.classList.remove('show-button');
              $('.yesterdayorderbtn').css('display', 'none');
            }
            $('#badge-counter-yesterday').css('display', 'none');
          }

        } else if (data.error) {
          console.error('[Delivery Date] Error in location settings:', data.error);
        } else {
          console.log('[Delivery Date] Today order button conditions NOT met:', {
            start_time: data.start_time,
            end_time: data.end_time,
            is_active: data.is_active,
            accept_only_preorders: data.accept_only_preorders,
            immediate_inventory: data.immediate_inventory,
            minDate: minDate
          });

          // =========================================================================
          // YESTERDAY ITEMS BUTTON (when today button is NOT shown)
          // This handles the case where the today button conditions are not met
          // (e.g., minDate != 1) but the yesterday items feature is enabled.
          // =========================================================================
          if (data.immediate_inventory_48h === 'Y' && data.immediate_inventory === 'Y') {
            console.log('[Delivery Date] Yesterday items feature enabled (today btn not shown)');

            const yesterdayUrl = `https://dev.sushi.catering/getImmediateInventoryByLocationForYesterday/${window.deliveryDateState.location}`;

            $.ajax({
              url: yesterdayUrl,
              type: "GET",
              async: true,
              cache: true,
              dataType: "json",
              success: function(yesterdayQty) {
                console.log('[Delivery Date] Yesterday inventory count:', yesterdayQty);

                const buttonYesterdayOrder = document.querySelector('.yesterdayorderbtn');
                if (yesterdayQty > 0) {
                  if (buttonYesterdayOrder) {
                    buttonYesterdayOrder.classList.add('show-button');
                    $('.yesterdayorderbtn').css('display', 'inline-flex');
                  }
                  $('#badge-counter-yesterday')
                    .html(yesterdayQty)
                    .removeClass('text-bg-danger')
                    .addClass('text-bg-success')
                    .css('display', 'inline-block');
                  console.log('[Delivery Date] Yesterday button shown with qty:', yesterdayQty);
                } else {
                  if (buttonYesterdayOrder) {
                    buttonYesterdayOrder.classList.remove('show-button');
                    $('.yesterdayorderbtn').css('display', 'none');
                  }
                  $('#badge-counter-yesterday').css('display', 'none');
                  console.log('[Delivery Date] Yesterday button hidden - no items');
                }
              },
              error: function(request, status, error) {
