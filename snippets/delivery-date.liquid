                updateTodayBadgeCounter(window.deliveryDateState.location);
                // On error: show button disabled with red zero badge
                setYesterdayDisplay(true);
                const buttonYesterdayOrder = document.querySelector('.yesterdayorderbtn');
                if (buttonYesterdayOrder) {
                  setActionButtonDisabled(buttonYesterdayOrder, true, 'Keine Artikel verfügbar');
                }
                $('#badge-counter-yesterday')
                  .html(0)
                  .removeClass('text-bg-success')
                  .addClass('text-bg-danger')
                  .addClass('yesterday-inline-flex')
                  .removeClass('yesterday-hidden');
              }
            });
          } else {
            // 48h feature disabled - just show today's inventory on today badge
            console.log('[Delivery Date] 48h feature disabled, showing today inventory only');
            updateTodayBadgeCounter(window.deliveryDateState.location);

            // Set up interval for today badge refresh
            setInterval(() => {
              updateTodayBadgeCounter(window.deliveryDateState.location);
            }, 60000);

            // Ensure yesterday button is hidden
            setYesterdayDisplay(false);
          }

        } else if (data.error) {
          console.error('[Delivery Date] Error in location settings:', data.error);
        } else {
          console.log('[Delivery Date] Today order button conditions NOT met:', {
            start_time: data.start_time,
            end_time: data.end_time,
            is_active: data.is_active,
            accept_only_preorders: data.accept_only_preorders,
