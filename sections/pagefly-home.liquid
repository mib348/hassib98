partners.png?v=1758898562&width=2048 2048w" fetchPriority="low" decoding="async" loading="lazy" style="--pf-image-ratio:3" width="717" height="239" sizes="(min-width: 1200px) 14vw, (min-width: 1025px) and (max-width: 1199px) 17vw, (min-width: 768px) and (max-width: 1024px) 20vw, (max-width: 767px) 33vw" data-pf-type="Image4" class="sc-djTQOc gPiVMd pf-501_" store="[object Object]"/></div></div></div></div></div><button type="button" style="visibility:visible" aria-label="Previous" class="pf-slider-prev none hide"></button><button type="button" style="visibility:visible" aria-label="Next" class="pf-slider-next none hide"></button></div></div></div></div></div></div></div><div data-section-id="pf-cc24" data-category="Generic content" data-name="Couverture" data-pf-type="Section" class="sc-enkJyZ cShsjg pf-239_ pf-color-scheme-1"><div class="sc-huFOms ccolBP"><div class="sc-hzhKNl fltMam pf-240_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:5;--c-lg:6"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-241_ pf-bg-lazy"></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:7;--c-lg:6"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-242_"><h3 data-pf-type="Heading2" class="sc-gplwNw jqcdAe pf-243_ pf-heading-1-h3">Kostenfreie<br>Catering-Station <br>ab 50 Mitarbeiter</h3><p class="sc-cTTcKX grRDLS pf-245_ pf-text-1" data-pf-type="Paragraph3">Unsere Catering-Station ist deine kostenfreie&nbsp;Mitarbeiterverpflegung ab 50 Mitarbeiter.</p><div class="sc-czLrCa eTWLOc pf-247_ pf-r pf-r-ew pf-c-ct pf-r-eh" style="--s-xs:8px;--s-sm:16px;--ew-xs:1" data-pf-type="ContentList"><div class="pf-c"><div data-pf-type="ContentListItem" class="sc-kUXBrD lasuEg rid-23"><div class="sc-hzhKNl fltMam rid-22 pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:3;--c-sm:2;--c-md:2;--c-lg:2"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY rid-16"><i class="sc-bHnkpz hbEJPn rid-15 pf-icon-1 pfa pfa-box-open" data-pf-type="Icon"></i></div></div><div class="pf-c" style="--c-xs:9;--c-sm:10;--c-md:10;--c-lg:10"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY rid-21"><h3 data-pf-type="Heading2" class="sc-gplwNw jqcdAe rid-18 pf-heading-1-h3">Täglich frisch</h3><p class="sc-cTTcKX grRDLS rid-20 pf-text-1" data-pf-type="Paragraph3">Unsere Gerichte werden auf Basis der Vorbestellungen jeden Tag frisch hergestellt und täglich vor 12 Uhr an die Catering-Station geliefert. Die Station beinhaltet weiterhin&nbsp;frische Gerichte für Sofortkäufe, welche zusätzlich zu den Vorbestellungen geliefert werden. Nicht verkaufte Gerichte werden am nächsten Tag wieder mitgenommen. Damit haben alle Mitarbeiter einen 24/7 Zugang zu frischen Gerichten am Artbeitsplatz.</p></div></div></div></div></div><div class="pf-c"><div data-pf-type="ContentListItem" class="sc-kUXBrD lasuEg rid-23"><div class="sc-hzhKNl fltMam rid-22 pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:3;--c-sm:2;--c-md:2;--c-lg:2"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY rid-16"><i class="sc-bHnkpz hbEJPn rid-15 pf-icon-1 pfa pfa-hand-holding-heart" data-pf-type="Icon"></i></div></div><div class="pf-c" style="--c-xs:9;--c-sm:10;--c-md:10;--c-lg:10"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY rid-21"><h3 data-pf-type="Heading2" class="sc-gplwNw jqcdAe rid-18 pf-heading-1-h3">online bestellen</h3><p class="sc-cTTcKX grRDLS rid-20 pf-text-1" data-pf-type="Paragraph3">Einfach online bestellen, online bezahlen und Bestellung per QR-Code an der Station abholen. QR-Code scannen, Tür öffnen, Gerichte entnehmen, Tür schließen und fertig. Kameras überprüfen die Entnahme. Bestellungen sind ausschließlich online möglich über unsere Webseite und bis 9:45 Uhr am gleichen Tag.</p></div></div></div></div></div><div class="pf-c"><div data-pf-type="ContentListItem" class="sc-kUXBrD lasuEg rid-23"><div class="sc-hzhKNl fltMam rid-22 pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:3;--c-sm:2;--c-md:2;--c-lg:2"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY rid-16"><i class="sc-bHnkpz hbEJPn rid-15 pf-icon-1 pfa pfa-lightbulb" data-pf-type="Icon"></i></div></div><div class="pf-c" style="--c-xs:9;--c-sm:10;--c-md:10;--c-lg:10"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY rid-21"><h3 data-pf-type="Heading2" class="sc-gplwNw jqcdAe rid-18 pf-heading-1-h3">Echt kostenlos</h3><p class="sc-cTTcKX grRDLS rid-20 pf-text-1" data-pf-type="Paragraph3">Die Catering-Station ist für dein Unternehm komplett kostenfrei und monatlich kündbar. Mit unserem Catering-Lieferservice garantieren wir dir den besten Preis für frisch zubereitete und direkt gelieferte Gerichte. Wir liefern unsere Gerichte in einer großen Sammellieferung aus und liefern ohne Mindestbestellwert und Liefergebühren.&nbsp;Solltet ihr euch zu einem späteren Zeitpunkt gegen die Station entscheiden, holen wir sie selbstverständlich wieder ab, ganz&nbsp;ohne Kosten und Aufwand für euch.</p></div></div></div></div></div></div></div></div></div></div></div><div data-section-id="pf-928b" data-pf-type="Section" class="sc-enkJyZ cShsjg pf-275_"><div style="--cw:1170px" class="sc-huFOms ccolBP"><div class="sc-hzhKNl fltMam pf-276_ pf-r pf-r-eh" style="--s-xs:8px;--s-sm:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-277_"><h3 data-pf-type="Heading2" class="sc-gplwNw jqcdAe pf-278_">FAQ</h3></div></div></div></div></div><div data-section-id="pf-7f1e" data-category="FAQs" data-name="Lovey" data-pf-type="Section" class="sc-enkJyZ cShsjg pf-280_ pf-color-scheme-1"><div style="--cw:1170px" class="sc-huFOms ccolBP"><div class="sc-hzhKNl fltMam pf-281_ pf-r pf-r-eh" style="--s-xs:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-282_"><div class="sc-dcJtft hisXnU pf-283_ pf-icon-right" data-scrolling="false" data-multiple="false" data-pf-type="Accordion"><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-284_"><button type="button" class="sc-eqUzNf hEUCJf pf-285_ pf-bg-lazy pf-anchor" data-header-id="1effbd96-596c-42d9-a6c7-10ebf2dc29fc" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Wie viele Gerichte werden zusätzlich geliefert?
</span></button><div data-pf-expandable="true" data-id="1effbd96-596c-42d9-a6c7-10ebf2dc29fc" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-287_"><div class="sc-hzhKNl fltMam pf-288_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-289_"><p class="sc-cTTcKX grRDLS pf-290_ pf-text-1" data-pf-type="Paragraph3">Die Anzahl der Gerichte für den Sofortkauf wird individuell an die Unternehmensgröße angepasst. Bei einer Belegschaft von etwa 100–200 Personen liefern wir in der Regel zwei zusätzliche Gerichte pro Tag. Bei größeren Standorten kann dieser Bestand entsprechend erhöht werden, um der Nachfrage gerecht zu werden. So bleibt die Station jederzeit gut bestückt – ohne Überproduktion und mit maximaler Flexibilität.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-292_"><button type="button" class="sc-eqUzNf hEUCJf pf-293_ pf-bg-lazy pf-anchor" data-header-id="19014a06-da04-47d8-a39e-5cbca67127a2" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Was passiert mit nicht verkauften Gerichten?
</span></button><div data-pf-expandable="true" data-id="19014a06-da04-47d8-a39e-5cbca67127a2" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-295_"><div class="sc-hzhKNl fltMam pf-296_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-297_"><p class="sc-cTTcKX grRDLS pf-298_ pf-text-1" data-pf-type="Paragraph3">Nicht verkaufte Gerichte werden am nächsten Tag wieder mitgenommen und die Station wird wieder mit neuen täglich frisch hergestellten Bowls befüllt.<br></p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-300_"><button type="button" class="sc-eqUzNf hEUCJf pf-301_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="df5e6b57-b075-4ba6-b638-06dbe94e83a9" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Kann ich meine Bestellung nachverfolgen?</span></button><div data-pf-expandable="true" data-id="df5e6b57-b075-4ba6-b638-06dbe94e83a9" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-303_"><div class="sc-hzhKNl fltMam pf-304_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-305_"><p class="sc-cTTcKX grRDLS pf-306_ pf-text-1" data-pf-type="Paragraph3">Ja, den aktuellen Lieferstatus deiner Bestellung kannst du jederzeit einsehen. Oberhalb&nbsp;der Schaltflächen für Sofortbestellung und Vorbestellung findest du auf der Bestellseite des jeweiligen Standortes den Hinweis „Status Lieferung Heute“. So können alle Mitarbeiter im Haus einfach online nachprüfen, ob und wann die Bestellung eingetroffen ist, sodass der Gang zur Station zur Überprüfung der Lieferung nicht mehr nötig ist.<br></p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-308_"><button type="button" class="sc-eqUzNf hEUCJf pf-309_ pf-bg-lazy pf-anchor" data-header-id="e2d84f0e-591a-4a48-8311-2088c6759f36" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Wie kann ich Saucen bestellen?</span></button><div data-pf-expandable="true" data-id="e2d84f0e-591a-4a48-8311-2088c6759f36" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-311_"><div class="sc-hzhKNl fltMam pf-312_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-313_"><p class="sc-cTTcKX grRDLS pf-314_ pf-text-1" data-pf-type="Paragraph3">Die Saucen werden in gleicher Anzahl wie die bestellten Gerichte in der Catering-Station bereitgestellt. Pro Artikel können Mitarbeitende jeweils eine Sauce nach Wahl sowie eine Sojasauce entnehmen. Eine individuelle Auswahl oder separate Bestellung von Saucen ist derzeit nicht möglich.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-316_"><button type="button" class="sc-eqUzNf hEUCJf pf-317_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="e39e5cbc-a671-47a2-90a2-d423937b43ad" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Wie zahlen die Mitarbeiter?
</span></button><div data-pf-expandable="true" data-id="e39e5cbc-a671-47a2-90a2-d423937b43ad" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-319_"><div class="sc-hzhKNl fltMam pf-320_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-321_"><p class="sc-cTTcKX grRDLS pf-322_ pf-text-1" data-pf-type="Paragraph3">Die Bestellung und Zahlung&nbsp;erfolgt durch die Mitarbeitenden eigenständig über unsere Webseite. Die Bezahlung ist ausschließlich online möglich – unterstützt werden gängige Zahlungsmethoden wie PayPal, Kreditkarte, Klarna und weitere. Vor Ort an der Station sind keine physischen Zahlungsoptionen wie Kartenlesegeräte oder Bargeldzahlung möglich.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-324_"><button type="button" class="sc-eqUzNf hEUCJf pf-325_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="6cfc0440-34c1-4716-9ba4-76a38c2f3f70" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Welche technischen Anforderungen sind für den Betrieb der Station erforderlich?</span></button><div data-pf-expandable="true" data-id="6cfc0440-34c1-4716-9ba4-76a38c2f3f70" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-327_"><div class="sc-hzhKNl fltMam pf-328_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-329_"><p class="sc-cTTcKX grRDLS pf-330_ pf-text-1" data-pf-type="Paragraph3">Es wird nur ein&nbsp;haushaltsüblicher Stromanschluss benötigt.&nbsp;Der Stromverbrauch der Station liegt ca. bei 75 kWh pro Monat. Die Station verfügt über einen eigenen Router und eigenes Internet.&nbsp;Die Station&nbsp;kann problemlos auf einem vorhandenen Tisch oder Tresen platziert werden. Sollte keine geeignete Ablagefläche vorhanden sein, stellen wir bei Bedarf einen passenden Tisch zur Verfügung.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-332_"><button type="button" class="sc-eqUzNf hEUCJf pf-333_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="d0a2d423-937b-43ad-acfc-044034c14716" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Wie viel Platz benötigt die Station?
  </span></button><div data-pf-expandable="true" data-id="d0a2d423-937b-43ad-acfc-044034c14716" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-335_"><div class="sc-hzhKNl fltMam pf-336_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-337_"><p class="sc-cTTcKX grRDLS pf-338_ pf-text-1" data-pf-type="Paragraph3">Die Station ist äußerst kompakt und benötigt lediglich eine Stellfläche von ca. 60 × 60 cm. Sie kann problemlos auf einem vorhandenen Tisch oder Tresen platziert werden. Sollte keine geeignete Ablagefläche vorhanden sein, stellen wir bei Bedarf einen passenden Tisch zur Verfügung. Die Höhe der Station beträgt ca. 110 cm ohne Tisch und rund 183 cm inklusive Tisch.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-340_"><button type="button" class="sc-eqUzNf hEUCJf pf-341_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="ece4061a-c0c3-440c-9bfa-af9fcad0c368" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Welcher Bereich der Station wird von der Kamera erfasst?</span></button><div data-pf-expandable="true" data-id="ece4061a-c0c3-440c-9bfa-af9fcad0c368" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-343_"><div class="sc-hzhKNl fltMam pf-344_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-345_"><p class="sc-cTTcKX grRDLS pf-346_ pf-text-1" data-pf-type="Paragraph3">Die Kamera ist auf der Innenseite der Tür der Catering-Station installiert und erstellt pro Entnahmevorgang exakt zwei Aufnahmen – eine unmittelbar vor und eine unmittelbar nach der Entnahme, jeweils bei geschlossener Tür. Erfasst wird ausschließlich der Inhalt der Station. Personen oder die Umgebung werden zu keinem Zeitpunkt aufgezeichnet. Damit ist eine unbeschwerte Nutzung der Station unter Einhaltung der Vorgaben der DSGVO gewährleistet.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-348_"><button type="button" class="sc-eqUzNf hEUCJf pf-349_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="6df8a3ad-3afb-4902-a215-4162a9e8a9df" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Ist eine Sicherheitsprüfung unserer Mitarbeiter möglich?</span></button><div data-pf-expandable="true" data-id="6df8a3ad-3afb-4902-a215-4162a9e8a9df" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-351_"><div class="sc-hzhKNl fltMam pf-352_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-353_"><p class="sc-cTTcKX grRDLS pf-354_ pf-text-1" data-pf-type="Paragraph3">Für sicherheitsrelevante Bereiche in Behörden, Ämtern und bei der Polizei können unsere Fahrer einer Sicherheitsüberprüfung unterzogen werden, um die Belieferung der Stationen in diesen Arealen reibungslos und ohne Einschränkungen zu gewährleisten.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-356_"><button type="button" class="sc-eqUzNf hEUCJf pf-357_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="cbc7c1e8-81b8-458e-a72e-c8762d984f1a" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>GIbt es einen Testzeitraum für die Station ?</span></button><div data-pf-expandable="true" data-id="cbc7c1e8-81b8-458e-a72e-c8762d984f1a" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-359_"><div class="sc-hzhKNl fltMam pf-360_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-361_"><p class="sc-cTTcKX grRDLS pf-362_ pf-text-1" data-pf-type="Paragraph3">Sie können die Station als Unternehmen unverbindlich, vertragsfrei und kostenfrei testen – so lange Sie möchten. Sollte die Station zu einem späteren Zeitpunkt nicht mehr Ihren Erwartungen entsprechen, holen wir sie selbstverständlich kostenfrei und unkompliziert wieder ab.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-364_"><button type="button" class="sc-eqUzNf hEUCJf pf-365_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="1ba476a3-8c2f-4f70-9025-df42342e2737" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Wie und wo kann ich eine Catering-Station anfragen?</span></button><div data-pf-expandable="true" data-id="1ba476a3-8c2f-4f70-9025-df42342e2737" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf