/0784/1356/2204/files/nbspartners.png?v=1758898562&width=1920 1920w,https://cdn.shopify.com/s/files/1/0784/1356/2204/files/nbspartners.png?v=1758898562&width=2048 2048w" fetchPriority="low" decoding="async" loading="lazy" style="--pf-image-ratio:3" width="717" height="239" sizes="(min-width: 1200px) 14vw, (min-width: 1025px) and (max-width: 1199px) 17vw, (min-width: 768px) and (max-width: 1024px) 20vw, (max-width: 767px) 33vw" data-pf-type="Image4" class="sc-djTQOc gPiVMd pf-753_" store="[object Object]"/></div></div></div></div></div><button type="button" style="visibility:visible" aria-label="Previous" class="pf-slider-prev none hide"></button><button type="button" style="visibility:visible" aria-label="Next" class="pf-slider-next none hide"></button></div></div></div></div></div></div></div><div data-section-id="pf-cc24" data-category="Generic content" data-name="Couverture" data-pf-type="Section" class="sc-enkJyZ cShsjg pf-754_ pf-color-scheme-1"><div class="sc-huFOms ccolBP"><div class="sc-hzhKNl fltMam pf-755_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:5;--c-lg:6"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-756_ pf-bg-lazy"></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:7;--c-lg:6"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-757_"><h3 data-pf-type="Heading2" class="sc-gplwNw jqcdAe pf-758_ pf-heading-1-h3">Kostenfreie<br>Catering-Station <br>ab 50 Mitarbeiter</h3><p class="sc-cTTcKX grRDLS pf-760_ pf-text-1" data-pf-type="Paragraph3">Unsere Catering-Station ist deine kostenfreie&nbsp;Mitarbeiterverpflegung ab 50 Mitarbeiter.</p><div class="sc-czLrCa eTWLOc pf-762_ pf-r pf-r-ew pf-c-ct pf-r-eh" style="--s-xs:8px;--s-sm:16px;--ew-xs:1" data-pf-type="ContentList"><div class="pf-c"><div data-pf-type="ContentListItem" class="sc-kUXBrD lasuEg rid-23"><div class="sc-hzhKNl fltMam rid-22 pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:3;--c-sm:2;--c-md:2;--c-lg:2"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY rid-16"><i class="sc-bHnkpz hbEJPn rid-15 pf-icon-1 pfa pfa-box-open" data-pf-type="Icon"></i></div></div><div class="pf-c" style="--c-xs:9;--c-sm:10;--c-md:10;--c-lg:10"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY rid-21"><h3 data-pf-type="Heading2" class="sc-gplwNw jqcdAe rid-18 pf-heading-1-h3">Täglich frisch</h3><p class="sc-cTTcKX grRDLS rid-20 pf-text-1" data-pf-type="Paragraph3">Unsere Gerichte werden auf Basis der Vorbestellungen jeden Tag frisch hergestellt und täglich vor 12 Uhr an die Catering-Station geliefert. Die Station beinhaltet weiterhin&nbsp;frische Gerichte für Sofortkäufe, welche zusätzlich zu den Vorbestellungen geliefert werden. Nicht verkaufte Gerichte werden am nächsten Tag wieder mitgenommen. Damit haben alle Mitarbeiter einen 24/7 Zugang zu frischen Gerichten am Artbeitsplatz.</p></div></div></div></div></div><div class="pf-c"><div data-pf-type="ContentListItem" class="sc-kUXBrD lasuEg rid-23"><div class="sc-hzhKNl fltMam rid-22 pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:3;--c-sm:2;--c-md:2;--c-lg:2"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY rid-16"><i class="sc-bHnkpz hbEJPn rid-15 pf-icon-1 pfa pfa-hand-holding-heart" data-pf-type="Icon"></i></div></div><div class="pf-c" style="--c-xs:9;--c-sm:10;--c-md:10;--c-lg:10"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY rid-21"><h3 data-pf-type="Heading2" class="sc-gplwNw jqcdAe rid-18 pf-heading-1-h3">online bestellen</h3><p class="sc-cTTcKX grRDLS rid-20 pf-text-1" data-pf-type="Paragraph3">Einfach online bestellen, online bezahlen und Bestellung per QR-Code an der Station abholen. QR-Code scannen, Tür öffnen, Gerichte entnehmen, Tür schließen und fertig. Kameras überprüfen die Entnahme. Bestellungen sind ausschließlich online möglich über unsere Webseite und bis 9:45 Uhr am gleichen Tag.</p></div></div></div></div></div><div class="pf-c"><div data-pf-type="ContentListItem" class="sc-kUXBrD lasuEg rid-23"><div class="sc-hzhKNl fltMam rid-22 pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:3;--c-sm:2;--c-md:2;--c-lg:2"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY rid-16"><i class="sc-bHnkpz hbEJPn rid-15 pf-icon-1 pfa pfa-lightbulb" data-pf-type="Icon"></i></div></div><div class="pf-c" style="--c-xs:9;--c-sm:10;--c-md:10;--c-lg:10"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY rid-21"><h3 data-pf-type="Heading2" class="sc-gplwNw jqcdAe rid-18 pf-heading-1-h3">Echt kostenlos</h3><p class="sc-cTTcKX grRDLS rid-20 pf-text-1" data-pf-type="Paragraph3">Die Catering-Station ist für dein Unternehm komplett kostenfrei und monatlich kündbar. Mit unserem Catering-Lieferservice garantieren wir dir den besten Preis für frisch zubereitete und direkt gelieferte Gerichte. Wir liefern unsere Gerichte in einer großen Sammellieferung aus und liefern ohne Mindestbestellwert und Liefergebühren.&nbsp;Solltet ihr euch zu einem späteren Zeitpunkt gegen die Station entscheiden, holen wir sie selbstverständlich wieder ab, ganz&nbsp;ohne Kosten und Aufwand für euch.</p></div></div></div></div></div></div></div></div></div></div></div><div data-section-id="pf-928b" data-pf-type="Section" class="sc-enkJyZ cShsjg pf-790_"><div style="--cw:1170px" class="sc-huFOms ccolBP"><div class="sc-hzhKNl fltMam pf-791_ pf-r pf-r-eh" style="--s-xs:8px;--s-sm:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-792_"><h3 data-pf-type="Heading2" class="sc-gplwNw jqcdAe pf-793_">FAQ</h3></div></div></div></div></div><div data-section-id="pf-7f1e" data-category="FAQs" data-name="Lovey" data-pf-type="Section" class="sc-enkJyZ cShsjg pf-795_ pf-color-scheme-1"><div style="--cw:1170px" class="sc-huFOms ccolBP"><div class="sc-hzhKNl fltMam pf-796_ pf-r pf-r-eh" style="--s-xs:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-797_"><div class="sc-dcJtft hisXnU pf-798_ pf-icon-right" data-scrolling="false" data-multiple="false" data-pf-type="Accordion"><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-799_"><button type="button" class="sc-eqUzNf hEUCJf pf-800_ pf-bg-lazy pf-anchor" data-header-id="1effbd96-596c-42d9-a6c7-10ebf2dc29fc" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Wie viele Gerichte werden zusätzlich geliefert?
</span></button><div data-pf-expandable="true" data-id="1effbd96-596c-42d9-a6c7-10ebf2dc29fc" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-802_"><div class="sc-hzhKNl fltMam pf-803_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-804_"><p class="sc-cTTcKX grRDLS pf-805_ pf-text-1" data-pf-type="Paragraph3">Die Anzahl der Gerichte für den Sofortkauf wird individuell an die Unternehmensgröße angepasst. Bei einer Belegschaft von etwa 100–200 Personen liefern wir in der Regel zwei zusätzliche Gerichte pro Tag. Bei größeren Standorten kann dieser Bestand entsprechend erhöht werden, um der Nachfrage gerecht zu werden. So bleibt die Station jederzeit gut bestückt – ohne Überproduktion und mit maximaler Flexibilität.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-807_"><button type="button" class="sc-eqUzNf hEUCJf pf-808_ pf-bg-lazy pf-anchor" data-header-id="19014a06-da04-47d8-a39e-5cbca67127a2" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Was passiert mit nicht verkauften Gerichten?
</span></button><div data-pf-expandable="true" data-id="19014a06-da04-47d8-a39e-5cbca67127a2" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-810_"><div class="sc-hzhKNl fltMam pf-811_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-812_"><p class="sc-cTTcKX grRDLS pf-813_ pf-text-1" data-pf-type="Paragraph3">Nicht verkaufte Gerichte werden am nächsten Tag wieder mitgenommen und die Station wird wieder mit neuen täglich frisch hergestellten Bowls befüllt.<br></p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-815_"><button type="button" class="sc-eqUzNf hEUCJf pf-816_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="df5e6b57-b075-4ba6-b638-06dbe94e83a9" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Kann ich meine Bestellung nachverfolgen?</span></button><div data-pf-expandable="true" data-id="df5e6b57-b075-4ba6-b638-06dbe94e83a9" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-818_"><div class="sc-hzhKNl fltMam pf-819_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-820_"><p class="sc-cTTcKX grRDLS pf-821_ pf-text-1" data-pf-type="Paragraph3">Ja, den aktuellen Lieferstatus deiner Bestellung kannst du jederzeit einsehen. Oberhalb&nbsp;der Schaltflächen für Sofortbestellung und Vorbestellung findest du auf der Bestellseite des jeweiligen Standortes den Hinweis „Status Lieferung Heute“. So können alle Mitarbeiter im Haus einfach online nachprüfen, ob und wann die Bestellung eingetroffen ist, sodass der Gang zur Station zur Überprüfung der Lieferung nicht mehr nötig ist.<br></p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-823_"><button type="button" class="sc-eqUzNf hEUCJf pf-824_ pf-bg-lazy pf-anchor" data-header-id="e2d84f0e-591a-4a48-8311-2088c6759f36" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Wie kann ich Saucen bestellen?</span></button><div data-pf-expandable="true" data-id="e2d84f0e-591a-4a48-8311-2088c6759f36" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-826_"><div class="sc-hzhKNl fltMam pf-827_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-828_"><p class="sc-cTTcKX grRDLS pf-829_ pf-text-1" data-pf-type="Paragraph3">Die Saucen werden in gleicher Anzahl wie die bestellten Gerichte in der Catering-Station bereitgestellt. Pro Artikel können Mitarbeitende jeweils eine Sauce nach Wahl sowie eine Sojasauce entnehmen. Eine individuelle Auswahl oder separate Bestellung von Saucen ist derzeit nicht möglich.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-831_"><button type="button" class="sc-eqUzNf hEUCJf pf-832_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="e39e5cbc-a671-47a2-90a2-d423937b43ad" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Wie zahlen die Mitarbeiter?
</span></button><div data-pf-expandable="true" data-id="e39e5cbc-a671-47a2-90a2-d423937b43ad" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-834_"><div class="sc-hzhKNl fltMam pf-835_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-836_"><p class="sc-cTTcKX grRDLS pf-837_ pf-text-1" data-pf-type="Paragraph3">Die Bestellung und Zahlung&nbsp;erfolgt durch die Mitarbeitenden eigenständig über unsere Webseite. Die Bezahlung ist ausschließlich online möglich – unterstützt werden gängige Zahlungsmethoden wie PayPal, Kreditkarte, Klarna und weitere. Vor Ort an der Station sind keine physischen Zahlungsoptionen wie Kartenlesegeräte oder Bargeldzahlung möglich.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-839_"><button type="button" class="sc-eqUzNf hEUCJf pf-840_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="6cfc0440-34c1-4716-9ba4-76a38c2f3f70" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Welche technischen Anforderungen sind für den Betrieb der Station erforderlich?</span></button><div data-pf-expandable="true" data-id="6cfc0440-34c1-4716-9ba4-76a38c2f3f70" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-842_"><div class="sc-hzhKNl fltMam pf-843_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-844_"><p class="sc-cTTcKX grRDLS pf-845_ pf-text-1" data-pf-type="Paragraph3">Es wird nur ein&nbsp;haushaltsüblicher Stromanschluss benötigt.&nbsp;Der Stromverbrauch der Station liegt ca. bei 75 kWh pro Monat. Die Station verfügt über einen eigenen Router und eigenes Internet.&nbsp;Die Station&nbsp;kann problemlos auf einem vorhandenen Tisch oder Tresen platziert werden. Sollte keine geeignete Ablagefläche vorhanden sein, stellen wir bei Bedarf einen passenden Tisch zur Verfügung.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-847_"><button type="button" class="sc-eqUzNf hEUCJf pf-848_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="d0a2d423-937b-43ad-acfc-044034c14716" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Wie viel Platz benötigt die Station?
  </span></button><div data-pf-expandable="true" data-id="d0a2d423-937b-43ad-acfc-044034c14716" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-850_"><div class="sc-hzhKNl fltMam pf-851_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-852_"><p class="sc-cTTcKX grRDLS pf-853_ pf-text-1" data-pf-type="Paragraph3">Die Station ist äußerst kompakt und benötigt lediglich eine Stellfläche von ca. 60 × 60 cm. Sie kann problemlos auf einem vorhandenen Tisch oder Tresen platziert werden. Sollte keine geeignete Ablagefläche vorhanden sein, stellen wir bei Bedarf einen passenden Tisch zur Verfügung. Die Höhe der Station beträgt ca. 110 cm ohne Tisch und rund 183 cm inklusive Tisch.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-855_"><button type="button" class="sc-eqUzNf hEUCJf pf-856_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="ece4061a-c0c3-440c-9bfa-af9fcad0c368" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Welcher Bereich der Station wird von der Kamera erfasst?</span></button><div data-pf-expandable="true" data-id="ece4061a-c0c3-440c-9bfa-af9fcad0c368" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-858_"><div class="sc-hzhKNl fltMam pf-859_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-860_"><p class="sc-cTTcKX grRDLS pf-861_ pf-text-1" data-pf-type="Paragraph3">Die Kamera ist auf der Innenseite der Tür der Catering-Station installiert und erstellt pro Entnahmevorgang exakt zwei Aufnahmen – eine unmittelbar vor und eine unmittelbar nach der Entnahme, jeweils bei geschlossener Tür. Erfasst wird ausschließlich der Inhalt der Station. Personen oder die Umgebung werden zu keinem Zeitpunkt aufgezeichnet. Damit ist eine unbeschwerte Nutzung der Station unter Einhaltung der Vorgaben der DSGVO gewährleistet.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-863_"><button type="button" class="sc-eqUzNf hEUCJf pf-864_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="6df8a3ad-3afb-4902-a215-4162a9e8a9df" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Ist eine Sicherheitsprüfung unserer Mitarbeiter möglich?</span></button><div data-pf-expandable="true" data-id="6df8a3ad-3afb-4902-a215-4162a9e8a9df" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-866_"><div class="sc-hzhKNl fltMam pf-867_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-868_"><p class="sc-cTTcKX grRDLS pf-869_ pf-text-1" data-pf-type="Paragraph3">Für sicherheitsrelevante Bereiche in Behörden, Ämtern und bei der Polizei können unsere Fahrer einer Sicherheitsüberprüfung unterzogen werden, um die Belieferung der Stationen in diesen Arealen reibungslos und ohne Einschränkungen zu gewährleisten.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-871_"><button type="button" class="sc-eqUzNf hEUCJf pf-872_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="cbc7c1e8-81b8-458e-a72e-c8762d984f1a" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>GIbt es einen Testzeitraum für die Station ?</span></button><div data-pf-expandable="true" data-id="cbc7c1e8-81b8-458e-a72e-c8762d984f1a" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-874_"><div class="sc-hzhKNl fltMam pf-875_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-876_"><p class="sc-cTTcKX grRDLS pf-877_ pf-text-1" data-pf-type="Paragraph3">Sie können die Station als Unternehmen unverbindlich, vertragsfrei und kostenfrei testen – so lange Sie möchten. Sollte die Station zu einem späteren Zeitpunkt nicht mehr Ihren Erwartungen entsprechen, holen wir sie selbstverständlich kostenfrei und unkompliziert wieder ab.</p></div></div></div></div></div><div data-pf-type="Accordion.Content.Wrapper" class="sc-iGgVNO dygSQz pf-879_"><button type="button" class="sc-eqUzNf hEUCJf pf-880_ pf-bg-lazy pf-anchor" href="#Die Catering-Station ist für Unternehmen, Hotels, Fitnessstudios, Universitäten, Krankenhäuser und viele weitere Einrichtungen konzipiert. Sie kann entweder eigenständig oder als Ergänzung zur bestehenden Kantine genutzt werden." data-header-id="1ba476a3-8c2f-4f70-9025-df42342e2737" data-active="false" data-pf-type="Accordion.Header"><i class="pfa pfa-chevron-right pfa-arrow"></i><span>Wie und wo kann ich eine Catering-Station anfragen?</span></button><div data-pf-expandable="true" data-id="1ba476a3-8c2f-4f70-9025-df42342e2737" style="display:none" data-pf-type="Accordion.Content" class="sc-fqkwJk gxNUkH pf-882_"><div class="sc-hzhKNl fltMam pf-883_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-884_"><p class="sc-cTTcKX grRDLS pf-885_ pf-text-1" data-pf-type="Paragraph3">Das geht ganz einfach über unser Kontaktformular <a href="/pages/station-anfrage" target="_self"></a><a href="/pages/fuer-unternehmen" target="_self">hier</a>. Wir melden uns dann bei dir.</p></div></div></div></div></div></div></div></div></div></div></div><div data-section-id="pf-f8c9" data-pf-type="Section" class="sc-enkJyZ cShsjg pf-887_"><div style="--cw:1170px" class="sc-huFOms ccolBP"><div class="sc-hzhKNl fltMam pf-888_ pf-r pf-r-eh" style="--s-xs:8px;--s-sm:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-889_"><h3 data-pf-type="Heading2" class="sc-gplwNw jqcdAe pf-890_">kürzlich installiert</h3></div></div></div></div></div><div data-section-id="pf-1ddd" data-pf-type="Section" class="sc-enkJyZ cShsjg pf-892_ pf-color-scheme-1"><div style="--cw:1170px" class="sc-huFOms ccolBP"><div class="sc-hzhKNl fltMam pf-893_ pf-r pf-r-eh" style="--s-xs:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-894_"><div data-pf-type="Slideshow" class="sc-iXzffn GQxKH pf-895_"><div data-id="slider-b8499c30-5723-4f81-8e62-ddc6f82821b0-all" class="pf-slider scrollfix" style="--ss-xs:1;--ss-sm:2;--ss-md:3;--ss-lg:3"><div class="pf-slide"><div class="sc-fbFjKN rUGA-D pf-896_" data-pf-type="SlideshowSlide"><div class="sc-hzhKNl fltMam pf-897_ pf-r pf-r-eh" style="--s-xs:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gVJwnc hMWwiY pf-898_"><img alt="techhub.