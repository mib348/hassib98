<script>
function populateStationDropdown() {
  $.ajax({
    url: 'https://app.sushi.catering/api/getLocationsList',
    type: "GET",
    async: true,
    cache: true,
    dataType: "json",
    success: function (data) {
      const dropdownMenu = $('#stationDropdown').next('.dropdown-menu');
      dropdownMenu.empty();

      if (data.public && Array.isArray(data.public)) {
        const publicHeader = $('<h6 class="dropdown-header"></h6>').text('ÖFFENTLICH');
        dropdownMenu.append(publicHeader);

        data.public.forEach(location => {
          const dropdownItem = $('<a class="dropdown-item station" href="/pages/datum"></a>').text(`${location.name}`);
          dropdownMenu.append(dropdownItem);
        });
      }

      if (data.private && typeof data.private === 'object') {
        const privateHeader = $('<h6 class="dropdown-header"></h6>').text('PRIVAT');
        dropdownMenu.append(privateHeader);

        Object.values(data.private).forEach(location => {
          const dropdownItem = $('<a class="dropdown-item station" href="/pages/datum"></a>').text(`${location.name}`);
          dropdownMenu.append(dropdownItem);
        });
      }
    },
    error: function (xhr, status, error) {
      console.error('Error fetching locations:', error);
    }
  });
}

populateStationDropdown();
</script>
